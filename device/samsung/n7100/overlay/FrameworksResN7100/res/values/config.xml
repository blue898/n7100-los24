<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The modem hangs off the EHCI controller over HSIC (bus 2, its OHCI companion is bus 3);
         apps mustn't see or claim it. USB OTG is the DWC2 controller, bus 1. -->
    <string-array name="config_usbHostDenylist" translatable="false">
        <item>/dev/bus/usb/002/</item>
        <item>/dev/bus/usb/003/</item>
    </string-array>

    <!-- RGB status LED (AN30259A): offer the notification light settings -->
    <bool name="config_intrusiveNotificationLed">true</bool>

    <!-- CM36651 light sensor (the HAL reports its white channel as lux) -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Lux thresholds: 2-3 in a dark room, a few hundred under room light -->
    <integer-array name="config_autoBrightnessLevels">
        <item>1</item>
        <item>3</item>
        <item>8</item>
        <item>15</item>
        <item>30</item>
        <item>60</item>
        <item>120</item>
        <item>250</item>
        <item>500</item>
        <item>1000</item>
        <item>2000</item>
        <item>4000</item>
        <item>8000</item>
    </integer-array>

    <!-- Brightness (0-255) below, between and above those levels -->
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>8</item>
        <item>12</item>
        <item>17</item>
        <item>23</item>
        <item>30</item>
        <item>40</item>
        <item>52</item>
        <item>66</item>
        <item>85</item>
        <item>110</item>
        <item>145</item>
        <item>190</item>
        <item>235</item>
        <item>255</item>
    </integer-array>
</resources>
