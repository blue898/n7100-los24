service vendor.power-n7100 /vendor/bin/hw/android.hardware.power-service.n7100
    class hal
    user system
    group system

# the frequency floors and caps the power HAL sets
on boot
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/class/devfreq/13000000.gpu/min_freq
    chown system system /sys/class/devfreq/13000000.gpu/max_freq
    chown system system /sys/class/devfreq/bus-dmc/min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/class/devfreq/13000000.gpu/min_freq
    chmod 0664 /sys/class/devfreq/13000000.gpu/max_freq
    chmod 0664 /sys/class/devfreq/bus-dmc/min_freq
