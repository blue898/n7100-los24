// Radio HAL for the Galaxy Note II: Samsung's legacy RIL (libsec-ril.so) behind the
// radio AIDL interfaces. gen/ is generated by gen_stubs.py from the frozen V3 AIDL.

// Host for the legacy RIL. libsec-ril.so links against libril.so (RIL_onRequestComplete,
// requestToString); its NEEDED entry is patched to libril-n7100.so (proprietary/README)
cc_library_shared {
    name: "libril-n7100",
    vendor: true,
    srcs: ["libril/ril_core.cpp"],
    header_libs: ["ril_headers"],
    export_header_lib_headers: ["ril_headers"],
    shared_libs: ["liblog"],
    cflags: ["-Wall", "-Werror"],
}

cc_binary {
    name: "android.hardware.radio-service.n7100",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["radio-n7100.rc"],
    vintf_fragments: ["radio-n7100.xml"],
    srcs: [
        "Indications.cpp",
        "RadioData.cpp",
        "RadioMessaging.cpp",
        "RadioModem.cpp",
        "RadioNetwork.cpp",
        "RadioSim.cpp",
        "RadioVoice.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.radio-V3-ndk",
        "android.hardware.radio.config-V3-ndk",
        "android.hardware.radio.data-V3-ndk",
        "android.hardware.radio.messaging-V3-ndk",
        "android.hardware.radio.modem-V3-ndk",
        "android.hardware.radio.network-V3-ndk",
        "android.hardware.radio.sim-V3-ndk",
        "android.hardware.radio.voice-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libril-n7100",
        "libutils",
    ],
    cflags: ["-Wall", "-Werror", "-Wno-unused-parameter"],
}

// Symbols of the old libcutils/gabi++ that libsec-ril.so and libstlport.so still need;
// libsec-ril's libcutils-v29.so dependency is patched to this (proprietary/README)
cc_library_shared {
    name: "libsecril-compat",
    vendor: true,
    srcs: ["compat/secril_compat.cpp"],
    shared_libs: ["libcutils", "librilutils", "libutils"],
    cflags: ["-Wall", "-Werror"],
}
