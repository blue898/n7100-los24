# Galaxy Note II (GT-N7100), mainline kernel. Partition names are the stock Samsung GPT labels.
#<src>                         <mnt_point>  <type>  <mnt_flags and options>                              <fs_mgr_flags>
/dev/block/by-name/SYSTEM      /system      ext4    ro,barrier=1                                         wait,first_stage_mount
/dev/block/by-name/HIDDEN      /vendor      ext4    ro,barrier=1                                         wait,first_stage_mount
# /metadata (aconfigd's flag storage, without it system_server dies on "Invalid feature flag") on the
# unused 8 MiB Samsung FOTA partition
/dev/block/by-name/OTA         /metadata    ext4    noatime,nosuid,nodev,discard                         wait,check,formattable,first_stage_mount
# File-based encryption with Adiantum: the Cortex-A9 has no AES instructions. No metadata
# encryption: mainline has no dm-default-key. An empty USERDATA gets formatted on first boot.
/dev/block/by-name/USERDATA    /data        ext4    noatime,nosuid,nodev,noauto_da_alloc,errors=panic    wait,check,formattable,fileencryption=adiantum:adiantum:v2,quota,reservedsize=128M
# EFS: IMEI and the modem's NV data; cbd rewrites nv_data.bin, so read-write
/dev/block/by-name/EFS         /efs         ext4    noatime,nosuid,nodev                                 wait

# microSD
/devices/platform/soc/12530000.mmc/mmc_host*   auto   auto   defaults   voldmanaged=sdcard1:auto

/dev/block/zram0               none         swap    defaults                                             zramsize=50%
