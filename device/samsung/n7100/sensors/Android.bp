// Galaxy Note II sensors: the SSP sensor hub behind /dev/ssp_sensorhub
cc_binary {
    name: "android.hardware.sensors-service.n7100",
    relative_install_path: "hw",
    init_rc: ["sensors-n7100.rc"],
    vintf_fragments: ["sensors-n7100.xml"],
    vendor: true,
    srcs: [
        "Sensors.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
    ],
    static_libs: [
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
        "android.hardware.sensors-V3-ndk",
        "android.system.suspend-V1-ndk",
        "libbase",
        "libcutils",
        "libfmq",
        "libpower",
        "libutils",
    ],
}
