# SSP sensor hub: /dev/ssp_sensorhub, the magnetometer's fuse ROM values in sysfs, saved
# magnetometer offsets in /data/vendor/sensors
allow hal_sensors_default ssp_device:chr_file rw_file_perms;
allow hal_sensors_default sensors_vendor_data_file:dir rw_dir_perms;
allow hal_sensors_default sensors_vendor_data_file:file create_file_perms;
r_dir_file(hal_sensors_default, sysfs_ssp)
