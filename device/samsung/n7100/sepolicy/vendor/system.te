# platform domains that need a little more on this hardware
# InputReader looks for keyboard backlights: the touchkey LED is the lights HAL's
dontaudit system_server sysfs_leds:file r_file_perms;

# The kernel loads firmware from /vendor/firmware itself (firmware_class.path)
allow kernel vendor_file:file r_file_perms;
allow kernel vendor_file:system firmware_load;
# devtmpfs is maintained by the kernel but not mounted: harmless
dontaudit kernel device:dir create_dir_perms;
dontaudit kernel device:{ chr_file blk_file } { create setattr unlink };
