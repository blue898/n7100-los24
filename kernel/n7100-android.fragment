# GT-N7100 mainline Android additions on top of android-base
# keep /dev/mem for n7100tool usbfix (dwc2 workaround)
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
# first-stage init mounts system/vendor and starts adbd without loading modules
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
# Android's USB service needs /sys/class/android_usb and its USB_STATE uevents (patch 0106)
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_FS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_NCM=y
CONFIG_USB_U_ETHER=y
# binder via binderfs (and legacy device nodes)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# gralloc/codec2 allocate from dma-buf heaps
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_SW_SYNC=y
# SELinux needs audit; put selinux into the active LSM list
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,bpf"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KERNEL_XZ=y
# own module directory, so these modules don't collide with the pmOS kernel package's
CONFIG_LOCALVERSION="-n7100"
# CONFIG_LOCALVERSION_AUTO is not set
# sboot ignores the boot.img cmdline; append Android's boot parameters to the bootloader's (ATAG) cmdline.
# console=tty0 last -> /dev/console and the kernel log go to the display.
# Boot parameters live in the DTB (/chosen/bootargs, patch 0003) and come before sboot's ATAG line
CONFIG_CMDLINE=""
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
# Android's libmodprobe/build expect plain .ko files
# CONFIG_MODULE_COMPRESS is not set
# Samsung S-Boot reboot reasons (INFORM3: recovery/download), node exists in exynos4412-midas.dtsi
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
# Post-mortem kernel log across warm resets (ramoops region in exynos4412-n710x.dtsi)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# A hung boot (nobody opens /dev/watchdog within 180 s) resets the SoC -> fallback system in BOOT
CONFIG_WATCHDOG_OPEN_TIMEOUT=180
# Android mounts cpuset (and memcg for lmkd) as cgroup v1 controllers; split out since 6.12
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG_V1=y
# The ARM32 eBPF JIT can't do atomics ("NOT YET: opcode c3"); with JIT_ALWAYS_ON those programs
# fail with ENOTSUPP instead of falling back to the interpreter, and NetBpfLoad aborts the boot
# CONFIG_BPF_JIT_ALWAYS_ON is not set
# netd's iptables rules (tables, matches, targets) as modules; vendor init loads them at early-init
# (n7100-modules.sh), the BOOT partition has no room left to build them in
CONFIG_NETFILTER_XT_MATCH_QUOTA2=m
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_NETFILTER_XT_MATCH_U32=m
CONFIG_NETFILTER_XT_MATCH_POLICY=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_IP_NF_MATCH_RPFILTER=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_TARGET_REJECT=m
# vmlinux BTF is 4.6 MB of loaded image: with it the decompressed 7.3 kernel plus the relocated zImage
# reach past 0x42000000, where sboot puts the ramdisk ("VFS: Unable to mount root fs"). Android's
# BPF programs carry their own BTF.
# CONFIG_DEBUG_INFO_BTF is not set

# brcmfmac debug messages (module parameter debug=), Wi-Fi bring-up
CONFIG_BRCMDBG=y

# S Pen (Wacom G5SP digitizer)
CONFIG_TOUCHSCREEN_WACOM_G5SP_I2C=y
# Sensor hub (SSP MCU): accelerometer, gyroscope, magnetometer, barometer, light/proximity
CONFIG_SAMSUNG_SSP_SENSORHUB=m
# File-based encryption of /data: Adiantum (the Cortex-A9 has no AES instructions; Android's
# choice for such CPUs), bit-sliced NEON AES for the rest
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_CRYPTO_AES_ARM_BS=y

# XMM6262 3G modem on HSIC0: Samsung modem_if port (cbd, libsec-ril)
CONFIG_SAMSUNG_MODEM_IF=m

# Responsiveness: 250 Hz tick (as GKI) instead of 100, schedutil (with the power HAL boosts
# and Android uclamp settings) instead of ondemand
CONFIG_HZ_250=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# USB OTG: the class drivers for what gets plugged in, built in (Android has no modprobe
# helper for hotplugged devices): flash drives (incl. UAS), keyboards/mice/gamepads
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID=y
# Quiet boot: the kernel console goes to the debug UART (DT bootargs), fbcon only takes the
# display over when something is written to it, no Tux logo
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# CONFIG_LOGO is not set

# /sys/power/pm_wakeup_irq and pm_debug_messages: what woke the phone
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
