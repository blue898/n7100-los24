# Keep zImage small: the Note II BOOT partition is 8 MiB for kernel + dtb + Android ramdisk.
# No SATA on this board
# CONFIG_ATA is not set
# Camera/codec stack is unusable on mainline for now -> modules
CONFIG_MEDIA_SUPPORT=m
# HDMI only via MHL dongle, not needed
# CONFIG_DRM_EXYNOS_HDMI is not set
# CONFIG_DRM_EXYNOS_MIXER is not set
CONFIG_F2FS_FS=m
# Samsung UARTs use their own driver, no 8250 and no TPM on the board
# CONFIG_SERIAL_8250 is not set
# CONFIG_TCG_TPM is not set
