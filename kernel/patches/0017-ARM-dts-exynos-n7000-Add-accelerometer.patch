From 7c9a7a77445c27d5e310c814532a59958857585d Mon Sep 17 00:00:00 2001
From: Raymond Hackley <raymondhackley@protonmail.com>
Date: Wed, 4 Oct 2023 02:55:22 +0000
Subject: [PATCH 17/89] ARM: dts: exynos: n7000: Add accelerometer

Signed-off-by: Raymond Hackley <raymondhackley@protonmail.com>
---
 .../arm/boot/dts/samsung/exynos4210-n7000.dts | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/arch/arm/boot/dts/samsung/exynos4210-n7000.dts b/arch/arm/boot/dts/samsung/exynos4210-n7000.dts
index 5ee4a128f..9a1f57af8 100644
--- a/arch/arm/boot/dts/samsung/exynos4210-n7000.dts
+++ b/arch/arm/boot/dts/samsung/exynos4210-n7000.dts
@@ -184,6 +184,33 @@ &hsotg {
 	status = "okay";
 };
 
+&i2c_1 {
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-slave-addr = <0x10>;
+	samsung,i2c-max-bus-freq = <100000>;
+
+	status = "okay";
+
+	accelerometer@19 {
+		compatible = "st,lis3dh-accel";
+		reg = <0x19>;
+
+		vdd-supply = <&vccpda_reg>;
+		vddio-supply = <&vccpda_reg>;
+
+		interrupts-extended = <&gpx3 0 IRQ_TYPE_LEVEL_HIGH>;
+
+		st,drdy-int-pin = <1>;
+
+		mount-matrix = "0", "1", "0",
+			       "1", "0", "0",
+			       "0", "0", "1";
+
+		pinctrl-0 = <&accel_int>;
+		pinctrl-names = "default";
+	};
+};
+
 &i2c_3 {
 	samsung,i2c-sda-delay = <100>;
 	samsung,i2c-slave-addr = <0x10>;
@@ -487,6 +514,11 @@ gpa0-3-pin {
 };
 
 &pinctrl_1 {
+	accel_int: accel-int-pins {
+		samsung,pins = "gpx3-0";
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
 	usb_sel: usb-sel-pins {
 		samsung,pins = "gpl0-6";
 		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
-- 
2.53.0

