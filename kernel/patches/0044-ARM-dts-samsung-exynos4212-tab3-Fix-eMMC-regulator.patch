From 08f02826fd2cb61226aed9e8f91d658b5cbd040c Mon Sep 17 00:00:00 2001
From: Artur Weber <aweber.kernel@gmail.com>
Date: Thu, 18 Jul 2024 23:11:48 +0200
Subject: [PATCH 44/89] ARM: dts: samsung: exynos4212-tab3: Fix eMMC regulator

Per the schematics, the eMMC uses regulator LDO18, which is also
enabled by the eMMC_EN GPIO pin. Add the LDO18 regulator config,
a dummy emmc_reg to handle the enable GPIO, and connect it to the
mshc_0 node.

Signed-off-by: Artur Weber <aweber.kernel@gmail.com>
---
 .../arm/boot/dts/samsung/exynos4212-tab3.dtsi | 27 ++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/samsung/exynos4212-tab3.dtsi b/arch/arm/boot/dts/samsung/exynos4212-tab3.dtsi
index 3b1a6f806..1d1c3e802 100644
--- a/arch/arm/boot/dts/samsung/exynos4212-tab3.dtsi
+++ b/arch/arm/boot/dts/samsung/exynos4212-tab3.dtsi
@@ -302,6 +302,18 @@ earmic_bias_reg: voltage-regulator-4 {
 		enable-active-high;
 	};
 
+	emmc_reg: voltage-regulator-5 {
+		compatible = "regulator-fixed";
+		regulator-name = "EMMC_2.8V";
+		regulator-min-microvolt = <2800000>;
+		regulator-max-microvolt = <2800000>;
+		vin-supply = <&ldo18_reg>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&emmc_enable>;
+		gpio = <&gpk0 2 GPIO_ACTIVE_HIGH>; /* eMMC_EN */
+		enable-active-high;
+	};
+
 	battery: battery {
 		compatible = "simple-battery";
 		constant-charge-current-max-microamp = <1800000>;
@@ -699,6 +711,13 @@ ldo17_reg: LDO17 {
 				regulator-always-on;
 			};
 
+			ldo18_reg: LDO18 {
+				regulator-name = "VMEM_VDD_2.8V";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+				op_mode = <1>;
+			};
+
 			ldo19_reg: LDO19 {
 				regulator-name = "VLED_IC_1.9V";
 				regulator-min-microvolt = <1900000>;
@@ -839,7 +858,7 @@ &mshc_0 {
 	broken-cd;
 	non-removable;
 	card-detect-delay = <200>;
-	vmmc-supply = <&ldo22_reg>;
+	vmmc-supply = <&emmc_reg>;
 	clock-frequency = <400000000>;
 	samsung,dw-mshc-ciu-div = <0>;
 	samsung,dw-mshc-sdr-timing = <2 3>;
@@ -1003,6 +1022,12 @@ backlight_reset: backlight-reset-pins {
 		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
 	};
 
+	emmc_enable: emmc-enable-pins {
+		samsung,pins = "gpk0-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
 	gpio_keys: gpio-keys-pins {
 		samsung,pins = "gpx1-2", "gpx2-2", "gpx2-4", "gpx2-7", "gpx3-3";
 		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
-- 
