From 971bc3b2aafe2d107a5388682c4bac7f5a24a614 Mon Sep 17 00:00:00 2001
From: Artur Weber <aweber.kernel@gmail.com>
Date: Mon, 5 Aug 2024 17:47:58 +0200
Subject: [PATCH 54/89] usb: exynos: ehci-exynos: Call phy_init and phy_exit on
 init/remove

Also set hcd->skip_phy_initialization = 1 so that the HCD core doesn't
try to initialize the PHYs a second time.

This fixes the following warnings:

  phy phy-125b0000.usb-phy.6: phy_power_on was called before phy_init
  phy phy-125b0000.usb-phy.7: phy_power_on was called before phy_init

Signed-off-by: Artur Weber <aweber.kernel@gmail.com>
---
 drivers/usb/host/ehci-exynos.c | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/host/ehci-exynos.c b/drivers/usb/host/ehci-exynos.c
index d2a5bedf7..43b6b321a 100644
--- a/drivers/usb/host/ehci-exynos.c
+++ b/drivers/usb/host/ehci-exynos.c
@@ -62,7 +62,7 @@ static int exynos_ehci_get_phy(struct device *dev,
 		exynos_ehci->phy[phy_number] = phy;
 	}
 	if (num_phys > 0)
-		return 0;
+		goto init_phys;
 
 	/* Get PHYs using legacy bindings */
 	for_each_available_child_of_node_scoped(dev->of_node, child) {
@@ -84,6 +84,12 @@ static int exynos_ehci_get_phy(struct device *dev,
 	}
 
 	exynos_ehci->legacy_phy = true;
+
+init_phys:
+	for (phy_number = 0; phy_number < PHY_NUMBER; phy_number++) {
+		phy_init(exynos_ehci->phy[phy_number]);
+	}
+
 	return 0;
 }
 
@@ -113,6 +119,16 @@ static void exynos_ehci_phy_disable(struct device *dev)
 		phy_power_off(exynos_ehci->phy[i]);
 }
 
+static void exynos_ehci_phy_exit(struct device *dev)
+{
+	struct usb_hcd *hcd = dev_get_drvdata(dev);
+	struct exynos_ehci_hcd *exynos_ehci = to_exynos_ehci(hcd);
+	int i;
+
+	for (i = 0; i < PHY_NUMBER; i++)
+		phy_exit(exynos_ehci->phy[i]);
+}
+
 static void exynos_setup_vbus_gpio(struct device *dev)
 {
 	struct gpio_desc *gpio;
@@ -152,6 +168,8 @@ static int exynos_ehci_probe(struct platform_device *pdev)
 	}
 	exynos_ehci = to_exynos_ehci(hcd);
 
+	hcd->skip_phy_initialization = 1;
+
 	err = exynos_ehci_get_phy(&pdev->dev, exynos_ehci);
 	if (err)
 		goto fail_io;
@@ -212,6 +230,7 @@ static int exynos_ehci_probe(struct platform_device *pdev)
 
 fail_add_hcd:
 	exynos_ehci_phy_disable(&pdev->dev);
+	exynos_ehci_phy_exit(&pdev->dev);
 	pdev->dev.of_node = exynos_ehci->of_node;
 fail_io:
 	usb_put_hcd(hcd);
@@ -228,6 +247,7 @@ static void exynos_ehci_remove(struct platform_device *pdev)
 	usb_remove_hcd(hcd);
 
 	exynos_ehci_phy_disable(&pdev->dev);
+	exynos_ehci_phy_exit(&pdev->dev);
 
 	usb_put_hcd(hcd);
 }
-- 
