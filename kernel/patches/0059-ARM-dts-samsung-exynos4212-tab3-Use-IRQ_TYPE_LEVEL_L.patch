From fe4594bc62f0759a9081899dca8c3d43f9b95a44 Mon Sep 17 00:00:00 2001
From: Artur Weber <aweber.kernel@gmail.com>
Date: Fri, 16 Aug 2024 23:41:43 +0200
Subject: [PATCH 59/89] ARM: dts: samsung: exynos4212-tab3: Use
 IRQ_TYPE_LEVEL_LOW for fuel alert

Following the Midas (commit 8a45f33bd36e ("ARM: dts: exynos: correct
fuel gauge interrupt trigger level on Midas family")) and p4note
(commit c731a16e2cf4 ("ARM: dts: exynos: correct fuel gauge interrupt
trigger level on P4 Note family") boards, use IRQ_TYPE_LEVEL_LOW for
the fuel gauge alert interrupt.

Signed-off-by: Artur Weber <aweber.kernel@gmail.com>
---
 arch/arm/boot/dts/samsung/exynos4212-tab3.dtsi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/samsung/exynos4212-tab3.dtsi b/arch/arm/boot/dts/samsung/exynos4212-tab3.dtsi
index be4db2298..5dbda39bf 100644
--- a/arch/arm/boot/dts/samsung/exynos4212-tab3.dtsi
+++ b/arch/arm/boot/dts/samsung/exynos4212-tab3.dtsi
@@ -189,7 +189,7 @@ fuel-gauge@36 {
 			compatible = "maxim,max17050";
 			reg = <0x36>;
 			interrupt-parent = <&gpx2>;
-			interrupts = <3 IRQ_TYPE_EDGE_FALLING>;
+			interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
 			pinctrl-names = "default";
 			pinctrl-0 = <&max77693_fuel_irq>;
 
-- 
2.53.0

