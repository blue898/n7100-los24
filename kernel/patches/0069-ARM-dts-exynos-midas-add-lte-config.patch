From 14eeefd976ca7b4a29aa9a4a1aa5bb0cafd990c4 Mon Sep 17 00:00:00 2001
From: Jack Knightly <J__A__K@hotmail.com>
Date: Thu, 21 Aug 2025 13:39:54 +0100
Subject: [PATCH 69/89] ARM: dts: exynos: midas: add lte config

Suggested-by: Joey Hewitt <joey@joeyhewitt.com>
Signed-off-by: Jack Knightly <J__A__K@hotmail.com>
---
 .../arm/boot/dts/samsung/exynos4412-i9305.dts |  1 +
 .../dts/samsung/exynos4412-midas-lte.dtsi     | 71 +++++++++++++++++++
 .../boot/dts/samsung/exynos4412-midas.dtsi    |  6 ++
 .../dts/samsung/exynos4412-n7105-ea8061.dts   |  1 +
 .../dts/samsung/exynos4412-n7105-s6evr02.dts  |  1 +
 5 files changed, 80 insertions(+)
 create mode 100644 arch/arm/boot/dts/samsung/exynos4412-midas-lte.dtsi

diff --git a/arch/arm/boot/dts/samsung/exynos4412-i9305.dts b/arch/arm/boot/dts/samsung/exynos4412-i9305.dts
index 8e6c462b3..3aafb5958 100644
--- a/arch/arm/boot/dts/samsung/exynos4412-i9305.dts
+++ b/arch/arm/boot/dts/samsung/exynos4412-i9305.dts
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 /dts-v1/;
 #include "exynos4412-galaxy-s3.dtsi"
+#include "exynos4412-midas-lte.dtsi"
 
 / {
 	model = "Samsung Galaxy S3 (GT-I9305) based on Exynos4412";
diff --git a/arch/arm/boot/dts/samsung/exynos4412-midas-lte.dtsi b/arch/arm/boot/dts/samsung/exynos4412-midas-lte.dtsi
new file mode 100644
index 000000000..8ec968fb5
--- /dev/null
+++ b/arch/arm/boot/dts/samsung/exynos4412-midas-lte.dtsi
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include "exynos-pinctrl.h"
+
+&pinctrl_0 {
+	ap2mdm-err-fatal-pins {
+		samsung,pins = "gpj0-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-val = <0>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+	ap2mdm-status-pins {
+		samsung,pins = "gpf1-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-val = <0>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+	mdm2ap-hsic-pwr-active-pins {
+		samsung,pins = "gpf2-2";
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
+
+&pinctrl_1 {
+	mdm2ap-err-fatal-pins {
+		samsung,pins = "gpx1-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+	mdm2ap-status-pins {
+		samsung,pins = "gpx0-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+	ap2mdm-hsic-port-active-pins {
+		samsung,pins = "gpx3-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS4_PIN_DRV_LV1>;
+	};
+	mdm2ap-hsic-resume-req-pins {
+		samsung,pins = "gpx0-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <EXYNOS4_PIN_DRV_LV1>;
+	};
+	ap2mdm-soft-reset-n-pins {
+		samsung,pins = "gpl2-5";
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+	ap2mdm-pmic-pwr-en-pins {
+		samsung,pins = "gpy2-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-val = <1>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+		samsung,pin-drv = <EXYNOS4_PIN_DRV_LV4>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
+	};
+	ap2mdm-wakeup-pins {
+		samsung,pins = "gpm2-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-val = <0>;
+		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_INPUT>;
+		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_DOWN>;
+	};
+};
diff --git a/arch/arm/boot/dts/samsung/exynos4412-midas.dtsi b/arch/arm/boot/dts/samsung/exynos4412-midas.dtsi
index 313dd2f75..0a63271ae 100644
--- a/arch/arm/boot/dts/samsung/exynos4412-midas.dtsi
+++ b/arch/arm/boot/dts/samsung/exynos4412-midas.dtsi
@@ -540,7 +540,11 @@ &dsi_0 {
 };
 
 &ehci {
+	samsung,vbus-gpio = <&gpf0 7 0>;
 	status = "okay";
+
+	phys = <&exynos_usbphy 2>;
+	phy-names = "hsic0";
 };
 
 &exynos_usbphy {
@@ -896,6 +900,7 @@ ldo15_reg: LDO15 {
 				regulator-name = "VHSIC_1.0V";
 				regulator-min-microvolt = <1000000>;
 				regulator-max-microvolt = <1000000>;
+				regulator-always-on; // Temporarily needed for modem
 				regulator-state-mem {
 					regulator-on-in-suspend;
 				};
@@ -905,6 +910,7 @@ ldo16_reg: LDO16 {
 				regulator-name = "VHSIC_1.8V";
 				regulator-min-microvolt = <1800000>;
 				regulator-max-microvolt = <1800000>;
+				regulator-always-on; // Temporarily needed for modem
 				regulator-state-mem {
 					regulator-on-in-suspend;
 				};
diff --git a/arch/arm/boot/dts/samsung/exynos4412-n7105-ea8061.dts b/arch/arm/boot/dts/samsung/exynos4412-n7105-ea8061.dts
index 5cf99414e..34b13c2e4 100644
--- a/arch/arm/boot/dts/samsung/exynos4412-n7105-ea8061.dts
+++ b/arch/arm/boot/dts/samsung/exynos4412-n7105-ea8061.dts
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 /dts-v1/;
 #include "exynos4412-n710x-ea8061.dtsi"
+#include "exynos4412-midas-lte.dtsi"
 
 / {
 	compatible = "samsung,n7105", "samsung,midas", "samsung,exynos4412", "samsung,exynos4";
diff --git a/arch/arm/boot/dts/samsung/exynos4412-n7105-s6evr02.dts b/arch/arm/boot/dts/samsung/exynos4412-n7105-s6evr02.dts
index af19aa879..398415ef1 100644
--- a/arch/arm/boot/dts/samsung/exynos4412-n7105-s6evr02.dts
+++ b/arch/arm/boot/dts/samsung/exynos4412-n7105-s6evr02.dts
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0
 /dts-v1/;
 #include "exynos4412-n710x-s6evr02.dtsi"
+#include "exynos4412-midas-lte.dtsi"
 
 / {
 	compatible = "samsung,n7105", "samsung,midas", "samsung,exynos4412", "samsung,exynos4";
