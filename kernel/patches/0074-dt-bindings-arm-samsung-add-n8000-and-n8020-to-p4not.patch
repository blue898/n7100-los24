From ff45f2ad233d71a0a97b3b520ac6a833382d7564 Mon Sep 17 00:00:00 2001
From: Martin Juecker <martin.juecker@gmail.com>
Date: Sat, 27 Sep 2025 01:27:21 +0200
Subject: [PATCH 74/89] dt-bindings: arm: samsung: add n8000 and n8020 to
 p4note

Document the compatible strings for n8000 and n8020 variants of the
p4note device family.

Signed-off-by: Martin Juecker <martin.juecker@gmail.com>
---
 .../devicetree/bindings/arm/samsung/samsung-boards.yaml         | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/samsung/samsung-boards.yaml b/Documentation/devicetree/bindings/arm/samsung/samsung-boards.yaml
index 1c2d6ef41..e31b4dce7 100644
--- a/Documentation/devicetree/bindings/arm/samsung/samsung-boards.yaml
+++ b/Documentation/devicetree/bindings/arm/samsung/samsung-boards.yaml
@@ -118,7 +118,9 @@ properties:
       - description: Samsung p4note family boards
         items:
           - enum:
+              - samsung,n8000                   # Samsung GT-N8000
               - samsung,n8010                   # Samsung GT-N8010/GT-N8013
+              - samsung,n8020                   # Samsung GT-N8020
           - const: samsung,p4note
           - const: samsung,exynos4412
           - const: samsung,exynos4
-- 
