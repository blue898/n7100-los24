From cc0e944976acdd5ed94cc0f5d9c559e4144983be Mon Sep 17 00:00:00 2001
From: Ferass El Hafidi <funderscore@postmarketos.org>
Date: Wed, 14 Jan 2026 19:00:20 +0000
Subject: [PATCH 79/89] input: touchscreen: wacom_w9000: add support for W9002
 variant

This is used on a few Samsung Exynos4-based devices such as the Samsung
Galaxy Note 8.0 (kona).

Signed-off-by: Ferass El Hafidi <funderscore@postmarketos.org>
---
 drivers/input/touchscreen/wacom_w9000.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/input/touchscreen/wacom_w9000.c b/drivers/input/touchscreen/wacom_w9000.c
index 4a2629a54..6e03881bf 100644
--- a/drivers/input/touchscreen/wacom_w9000.c
+++ b/drivers/input/touchscreen/wacom_w9000.c
@@ -412,10 +412,17 @@ static const struct wacom_w9000_variant w9007a_v1 = {
 	.name = "Wacom W9007A V1 Digitizer",
 };
 
+static const struct wacom_w9000_variant w9002_kona = {
+	.cmd_query_num  = 9,
+	.msg_coord_num  = 7,
+	.name = "Wacom W9002 KONA Digitizer",
+};
+
 static const struct of_device_id wacom_w9000_of_match[] = {
 	{ .compatible = "wacom,w9002", .data = &w9002 },
 	{ .compatible = "wacom,w9007a-lt03", .data = &w9007a_lt03, },
 	{ .compatible = "wacom,w9007a-v1", .data = &w9007a_v1, },
+	{ .compatible = "wacom,w9002-kona", .data = &w9002_kona, },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, wacom_w9000_of_match);
@@ -424,6 +431,7 @@ static const struct i2c_device_id wacom_w9000_id[] = {
 	{ .name = "w9002", .driver_data = (kernel_ulong_t)&w9002 },
 	{ .name = "w9007a-lt03", .driver_data = (kernel_ulong_t)&w9007a_lt03 },
 	{ .name = "w9007a-v1", .driver_data = (kernel_ulong_t)&w9007a_v1 },
+	{ .name = "w9002-kona", .driver_data = (kernel_ulong_t)&w9002_kona },
 	{ }
 };
 MODULE_DEVICE_TABLE(i2c, wacom_w9000_id);
-- 
