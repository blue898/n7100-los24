From 9ffed7077e2e302c11599a9139d8b26ca08802db Mon Sep 17 00:00:00 2001
From: Ferass El Hafidi <funderscore@postmarketos.org>
Date: Wed, 14 Jan 2026 19:02:29 +0000
Subject: [PATCH 81/89] arm: dts: exynos4412-kona: enable support for Wacom
 W9002

Enable the Wacom W9002 penabled digitizer found on the Exynos4412-based Samsung
Galaxy Note 8.0.

Signed-off-by: Ferass El Hafidi <funderscore@postmarketos.org>
---
 .../arm/boot/dts/samsung/exynos4412-kona.dtsi | 60 +++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/arch/arm/boot/dts/samsung/exynos4412-kona.dtsi b/arch/arm/boot/dts/samsung/exynos4412-kona.dtsi
index 6bc8a27b5..98d0044b6 100644
--- a/arch/arm/boot/dts/samsung/exynos4412-kona.dtsi
+++ b/arch/arm/boot/dts/samsung/exynos4412-kona.dtsi
@@ -117,6 +117,16 @@ wlan_pwrseq: sdhci3-pwrseq {
 		clock-names = "ext_clock";
 	};
 
+	stylus_reg: stylus-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "stylus_reg";
+		pinctrl-names = "default";
+		pinctrl-0 = <&stylus_ldo_en>;
+		gpio = <&gpc1 1 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&ldo3_reg>;
+	};
+
 	battery_cell: battery-cell {
 		compatible = "simple-battery";
 		device-chemistry = "lithium-ion";
@@ -469,6 +479,31 @@ key-menu {
 	};
 };
 
+&i2c_6 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	wacom_i2c: digitizer@56 {
+		compatible = "wacom,w9002-kona";
+		reg = <0x56>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&stylus_pdct &stylus_fwe &stylus_irq>;
+		interrupt-parent = <&gpc1>;
+		interrupts = <2 IRQ_TYPE_EDGE_RISING>;
+
+		vdd-supply = <&stylus_reg>;
+
+		pdct-gpios = <&gpc1 0 GPIO_ACTIVE_LOW>;
+		flash-mode-gpios = <&gpy1 3 GPIO_ACTIVE_HIGH>;
+
+		touchscreen-swapped-x-y;
+		touchscreen-inverted-x;
+		touchscreen-x-mm = <175>;
+		touchscreen-y-mm = <110>;
+	};
+};
+
 &i2c_7 {
 	samsung,i2c-sda-delay = <100>;
 	samsung,i2c-slave-addr = <0x10>;
@@ -731,6 +766,24 @@ &pinctrl_0 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&sleep0>;
 
+	stylus_pdct: stylus-pdct-pins {
+		samsung,pins = "gpc1-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_F>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
+	};
+
+	stylus_ldo_en: stylus-ldo-en-pins {
+		samsung,pins = "gpc1-1";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
+	stylus_irq: stylus-irq-pins {
+		samsung,pins = "gpc1-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_F>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+
 	// lcd_freq are not configured in board config
 	lcd_freq_scl: lcd-scl-pins {
 		samsung,pins = "gpf0-4";
@@ -957,6 +1010,13 @@ sdhci2_cd: sdhci2-cd-pins {
 		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
 	};
 
+	stylus_fwe: stylus-fwe-pins {
+		samsung,pins = "gpy1-3";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS4_PIN_DRV_LV1>;
+	};
+
 	sleep1: sleep-state {
 		PIN_SLP(gpk0-0, PREV, NONE); /* NAND_CLK */
 		PIN_SLP(gpk0-1, PREV, NONE); /* NAND_CMD */
-- 
2.53.0

