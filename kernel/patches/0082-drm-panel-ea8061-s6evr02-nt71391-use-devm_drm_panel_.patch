From 37f577d225c16460afb0536159d64f95d9f4f9c5 Mon Sep 17 00:00:00 2001
From: leo <leoschlosser@tutamail.com>
Date: Sat, 31 Oct 2026 09:49:27 +0100
Subject: [PATCH 82/89] drm/panel: ea8061, s6evr02, nt71391: use
 devm_drm_panel_alloc()

drm_panel_init() was removed upstream; allocate the driver context together
with the panel instead.
---
 drivers/gpu/drm/panel/panel-magnachip-ea8061.c | 8 ++++----
 drivers/gpu/drm/panel/panel-novatek-nt71391.c  | 9 ++++-----
 drivers/gpu/drm/panel/panel-samsung-s6evr02.c  | 9 ++++-----
 3 files changed, 12 insertions(+), 14 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-magnachip-ea8061.c b/drivers/gpu/drm/panel/panel-magnachip-ea8061.c
index 61578f358..8e7d08b69 100644
--- a/drivers/gpu/drm/panel/panel-magnachip-ea8061.c
+++ b/drivers/gpu/drm/panel/panel-magnachip-ea8061.c
@@ -721,9 +721,10 @@ static int ea8061_probe(struct mipi_dsi_device *dsi)
 	struct ea8061 *ctx;
 	int ret;
 
-	ctx = devm_kzalloc(dev, sizeof(struct ea8061), GFP_KERNEL);
-	if (!ctx)
-		return -ENOMEM;
+	ctx = devm_drm_panel_alloc(dev, struct ea8061, panel, &ea8061_drm_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
 
 	pr_err("ea8061 probing\n");
 
@@ -760,7 +761,6 @@ static int ea8061_probe(struct mipi_dsi_device *dsi)
 
 	ctx->brightness = GAMMA_LEVEL_NUM - 1;
 
-	drm_panel_init(&ctx->panel, dev, &ea8061_drm_funcs, DRM_MODE_CONNECTOR_DSI);
 	ctx->panel.prepare_prev_first = true;
 
 	drm_panel_add(&ctx->panel);
diff --git a/drivers/gpu/drm/panel/panel-novatek-nt71391.c b/drivers/gpu/drm/panel/panel-novatek-nt71391.c
index 73e920b02..5825115a7 100644
--- a/drivers/gpu/drm/panel/panel-novatek-nt71391.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt71391.c
@@ -166,9 +166,10 @@ static int novatek_nt71391_probe(struct mipi_dsi_device *dsi)
 	struct novatek_nt71391 *ctx;
 	int ret;
 
-	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
-	if (!ctx)
-		return -ENOMEM;
+	ctx = devm_drm_panel_alloc(dev, struct novatek_nt71391, panel, &novatek_nt71391_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
 
 	ctx->desc = of_device_get_match_data(dev);
 	if (!ctx->desc)
@@ -187,8 +188,6 @@ static int novatek_nt71391_probe(struct mipi_dsi_device *dsi)
 	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
 			  ctx->desc->mode_flags;
 
-	drm_panel_init(&ctx->panel, dev, &novatek_nt71391_panel_funcs,
-		       DRM_MODE_CONNECTOR_DSI);
 	ctx->panel.prepare_prev_first = true;
 
 	ret = drm_panel_of_backlight(&ctx->panel);
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6evr02.c b/drivers/gpu/drm/panel/panel-samsung-s6evr02.c
index 25c08c380..823a4d801 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6evr02.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6evr02.c
@@ -674,9 +674,10 @@ static int s6evr02_probe(struct mipi_dsi_device *dsi)
 	struct s6evr02 *ctx;
 	int ret = 0;
 
-	ctx = devm_kzalloc(dev, sizeof(struct s6evr02), GFP_KERNEL);
-	if (!ctx)
-		return -ENOMEM;
+	ctx = devm_drm_panel_alloc(dev, struct s6evr02, panel, &s6evr02_drm_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
 
 	pr_err("s6evr02 probing\n");
 
@@ -713,8 +714,6 @@ static int s6evr02_probe(struct mipi_dsi_device *dsi)
 
 	ctx->brightness = GAMMA_LEVEL_NUM - 1;
 
-	drm_panel_init(&ctx->panel, dev, &s6evr02_drm_funcs,
-		       DRM_MODE_CONNECTOR_DSI);
 	ctx->panel.prepare_prev_first = true;
 
 	drm_panel_add(&ctx->panel);
-- 
2.53.0

