From 42c4831c8a714554419baf9fc3a4a97f761abadf Mon Sep 17 00:00:00 2001
From: leo <leoschlosser@tutamail.com>
Date: Sat, 31 Oct 2026 16:13:40 +0100
Subject: [PATCH 89/89] drm: don't BUG on CRTC fences whose ops were cleared on
 signal

dma_fence_signal() now sets fence->ops to NULL for fences without release
and wait callbacks, which includes the CRTC out-fences. fence_to_crtc() still
insisted on ops == &drm_crtc_fence_ops, so asking for the driver or timeline
name of a fence that signals at the same time (sync_file_ioctl() from Android's
BootAnimation) hits the BUG_ON and panics the kernel:

  kernel BUG at drivers/gpu/drm/drm_crtc.c:161!
  PC is at drm_crtc_fence_get_driver_name+0x38/0x40
  LR is at sync_file_ioctl+0x358/0x69c

Accept NULL ops; only a foreign ops table is still a bug.
---
 drivers/gpu/drm/drm_crtc.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/drm_crtc.c b/drivers/gpu/drm/drm_crtc.c
index 63ead8ba6..272e00403 100644
--- a/drivers/gpu/drm/drm_crtc.c
+++ b/drivers/gpu/drm/drm_crtc.c
@@ -158,7 +158,15 @@ static const struct dma_fence_ops drm_crtc_fence_ops;
 
 static struct drm_crtc *fence_to_crtc(struct dma_fence *fence)
 {
-	BUG_ON(rcu_access_pointer(fence->ops) != &drm_crtc_fence_ops);
+	const struct dma_fence_ops *ops = rcu_access_pointer(fence->ops);
+
+	/*
+	 * dma_fence_signal() clears the ops of fences without release and wait
+	 * callbacks, like ours, so a fence that signals concurrently (e.g. while
+	 * sync_file_ioctl() asks for its driver name) can already have NULL ops
+	 * here. The crtc behind extern_lock stays valid.
+	 */
+	BUG_ON(ops && ops != &drm_crtc_fence_ops);
 	return container_of(fence->extern_lock, struct drm_crtc, fence_lock);
 }
 
