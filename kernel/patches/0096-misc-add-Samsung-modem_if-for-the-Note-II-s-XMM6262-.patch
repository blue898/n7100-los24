diff --git a/drivers/misc/modem_if/modem_main.c b/drivers/misc/modem_if/modem_main.c
new file mode 100755
index 000000000..f980c5868
--- /dev/null
+++ b/drivers/misc/modem_if/modem_main.c
@@ -0,0 +1,522 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2010 Google, Inc.
+ * Copyright (C) 2010 Samsung Electronics.
+ *
+ * Samsung modem_if for the Galaxy Note II (GT-N7100): Intel/Infineon XMM6262
+ * on the Exynos4412's HSIC0 port, SIPC4 framing. This combines Samsung's
+ * sipc4_modem.c (driver core) and board-m0-modems.c (board data), with the
+ * GPIOs taken from the device tree instead of a board file.
+ *
+ * The userspace interface is unchanged, so Samsung's cbd (modem boot daemon)
+ * and libsec-ril.so work as they did on the stock 3.0 kernel:
+ *   /dev/umts_boot0, umts_ipc0, umts_rfs0, umts_csd, umts_router,
+ *   umts_ramdump0, umts_loopback0, multipdp, /dev/link_pm, rmnet0-2 and
+ *   /sys/devices/platform/s5p-ehci/ehci_power (cbd power-cycles the HSIC host
+ *   around the modem's switch from boot ROM to firmware).
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio.h>
+#include <linux/gpio/consumer.h>
+#include <linux/interrupt.h>
+#include <linux/kernfs.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+#include "modem.h"
+#include "modem_prj.h"
+#include "modem_utils.h"
+
+#define FMT_WAKE_TIME   (HZ/2)
+#define RFS_WAKE_TIME   (HZ*3)
+#define RAW_WAKE_TIME   (HZ*6)
+
+
+/* umts target platform data (board-m0-modems.c) */
+static struct modem_io_t umts_io_devices[] = {
+	{ .name = "umts_ipc0", .id = 0x1, .format = IPC_FMT,
+	  .io_type = IODEV_MISC, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "umts_rfs0", .id = 0x41, .format = IPC_RFS,
+	  .io_type = IODEV_MISC, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "umts_boot0", .id = 0x0, .format = IPC_BOOT,
+	  .io_type = IODEV_MISC, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "multipdp", .id = 0x1, .format = IPC_MULTI_RAW,
+	  .io_type = IODEV_DUMMY, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "rmnet0", .id = 0x2A, .format = IPC_RAW,
+	  .io_type = IODEV_NET, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "rmnet1", .id = 0x2B, .format = IPC_RAW,
+	  .io_type = IODEV_NET, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "rmnet2", .id = 0x2C, .format = IPC_RAW,
+	  .io_type = IODEV_NET, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "umts_router", .id = 0x39, .format = IPC_RAW,
+	  .io_type = IODEV_MISC, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "umts_csd", .id = 0x21, .format = IPC_RAW,
+	  .io_type = IODEV_MISC, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "umts_ramdump0", .id = 0x0, .format = IPC_RAMDUMP,
+	  .io_type = IODEV_MISC, .links = LINKTYPE(LINKDEV_HSIC) },
+	{ .name = "umts_loopback0", .id = 0x3f, .format = IPC_RAW,
+	  .io_type = IODEV_MISC, .links = LINKTYPE(LINKDEV_HSIC) },
+};
+
+static struct modemlink_pm_data modem_link_pm_data;
+static struct modem_data umts_modem_data;
+static struct platform_device *ehci_pdev;	/* the HSIC host */
+static struct platform_device *s5p_ehci_compat, *s5p_ohci_compat;
+
+/* board-m0-modems.c: HSIC specific functions */
+static void set_slave_wake(void)
+{
+	if (gpio_get_value(modem_link_pm_data.gpio_link_hostwake)) {
+		mif_info("Slave Wake\n");
+		if (gpio_get_value(modem_link_pm_data.gpio_link_slavewake)) {
+			mif_info("Slave Wake set _-\n");
+			gpio_direction_output(
+				modem_link_pm_data.gpio_link_slavewake, 0);
+			mdelay(10);
+		}
+		gpio_direction_output(
+			modem_link_pm_data.gpio_link_slavewake, 1);
+	}
+}
+
+/* Samsung's EHCI driver drove ACTIVE_STATE (host active) with the host's
+ * power state; the CP only listens to it once out of reset */
+static void set_host_states(int active)
+{
+	if (!gpio_get_value(umts_modem_data.gpio_cp_reset)) {
+		mif_info("CP not ready, Active State low\n");
+		return;
+	}
+	gpio_direction_output(modem_link_pm_data.gpio_link_active, active);
+}
+
+static int umts_link_reconnect(void)
+{
+	if (gpio_get_value(umts_modem_data.gpio_phone_active) &&
+		gpio_get_value(umts_modem_data.gpio_cp_reset)) {
+		mif_info("trying reconnect link\n");
+		gpio_set_value(modem_link_pm_data.gpio_link_active, 0);
+		mdelay(10);
+		set_slave_wake();
+		gpio_set_value(modem_link_pm_data.gpio_link_active, 1);
+	} else
+		return -ENODEV;
+
+	return 0;
+}
+
+/* The pins the AP drives towards a powered-down CP; inputs stay inputs
+ * (gpiolib won't turn an IRQ line into an output) */
+static void xmm_gpio_revers_bias_clear(void)
+{
+	gpio_direction_output(umts_modem_data.gpio_pda_active, 0);
+	gpio_direction_output(modem_link_pm_data.gpio_link_active, 0);
+	gpio_direction_output(modem_link_pm_data.gpio_link_slavewake, 0);
+	msleep(20);
+}
+
+static void xmm_gpio_revers_bias_restore(void)
+{
+}
+
+/*
+ * /sys/devices/platform/s5p-ehci/ehci_power, where cbd looks for it: forward to
+ * the ehci_power node of the exynos-ehci driver (Simon Shields' "HACK: usb:
+ * host: ehci-exynos: add ehci_power sysfs node": HCD removed/added, PHY off/on,
+ * like Samsung's s5p-ehci), plus the ACTIVE_STATE handling Samsung's EHCI
+ * driver did through set_host_states().
+ */
+static struct device_attribute *ehci_power_attr(void)
+{
+	struct kernfs_node *kn;
+	struct attribute *attr;
+
+	if (!ehci_pdev)
+		return NULL;
+	kn = kernfs_find_and_get(ehci_pdev->dev.kobj.sd, "ehci_power");
+	if (!kn)
+		return NULL;
+	attr = kn->priv;
+	kernfs_put(kn);
+	return container_of(attr, struct device_attribute, attr);
+}
+
+static ssize_t ehci_power_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct device_attribute *real = ehci_power_attr();
+
+	if (!real || !real->show)
+		return -ENODEV;
+	return real->show(&ehci_pdev->dev, real, buf);
+}
+
+static ssize_t ehci_power_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct device_attribute *real = ehci_power_attr();
+	int power_on;
+	ssize_t ret;
+
+	if (kstrtoint(buf, 10, &power_on))
+		return -EINVAL;
+	if (!real || !real->store)
+		return -ENODEV;
+
+	mif_info("EHCI turns %s\n", power_on ? "on" : "off");
+	ret = real->store(&ehci_pdev->dev, real, buf, count);
+	set_host_states(!!power_on);
+	return ret;
+}
+static DEVICE_ATTR_RW(ehci_power);
+
+/* OHCI isn't on the HSIC port; accept the writes cbd also makes there */
+static ssize_t ohci_power_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "OHCI Power on\n");
+}
+
+static ssize_t ohci_power_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	return count;
+}
+static DEVICE_ATTR_RW(ohci_power);
+
+static int modem_register_hci_compat(struct device *dev)
+{
+	struct device_node *np;
+	int ret;
+
+	np = of_parse_phandle(dev->of_node, "samsung,hsic-host", 0);
+	if (!np)
+		return dev_err_probe(dev, -EINVAL, "no samsung,hsic-host\n");
+	ehci_pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!ehci_pdev)
+		return -EPROBE_DEFER;
+
+	s5p_ehci_compat = platform_device_register_simple("s5p-ehci", -1,
+							  NULL, 0);
+	if (IS_ERR(s5p_ehci_compat))
+		return PTR_ERR(s5p_ehci_compat);
+	ret = device_create_file(&s5p_ehci_compat->dev, &dev_attr_ehci_power);
+	if (ret)
+		return ret;
+
+	s5p_ohci_compat = platform_device_register_simple("s5p-ohci", -1,
+							  NULL, 0);
+	if (IS_ERR(s5p_ohci_compat))
+		return PTR_ERR(s5p_ohci_compat);
+	return device_create_file(&s5p_ohci_compat->dev, &dev_attr_ohci_power);
+}
+
+static int modem_get_gpio(struct device *dev, const char *con_id,
+			  enum gpiod_flags flags, unsigned *gpio)
+{
+	struct gpio_desc *desc = devm_gpiod_get(dev, con_id, flags);
+
+	if (IS_ERR(desc))
+		return dev_err_probe(dev, PTR_ERR(desc), "%s gpio\n", con_id);
+	gpiod_set_consumer_name(desc, con_id);
+	*gpio = desc_to_gpio(desc);
+	return 0;
+}
+
+static int modem_parse_dt(struct device *dev)
+{
+	struct modem_data *pd = &umts_modem_data;
+	struct modemlink_pm_data *pm = &modem_link_pm_data;
+	unsigned suspend_req;
+	struct clk *clk;
+	int ret;
+
+	/* The PMIC's 32 kHz CP clock. The boot ROM runs without it, the firmware
+	 * hangs (PHONE_ACTIVE high, never enumerates); stock left it on from the
+	 * bootloader, mainline gates it as unused */
+	clk = devm_clk_get_enabled(dev, "cp");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "cp clock\n");
+
+	/* umts_modem_cfg_gpio(): CP held off and in reset */
+	ret = modem_get_gpio(dev, "reset-req", GPIOD_OUT_LOW, &pd->gpio_reset_req_n) ?:
+	      modem_get_gpio(dev, "cp-on", GPIOD_OUT_LOW, &pd->gpio_cp_on) ?:
+	      modem_get_gpio(dev, "cp-reset", GPIOD_OUT_LOW, &pd->gpio_cp_reset) ?:
+	      modem_get_gpio(dev, "pda-active", GPIOD_OUT_LOW, &pd->gpio_pda_active) ?:
+	      modem_get_gpio(dev, "phone-active", GPIOD_IN, &pd->gpio_phone_active) ?:
+	      modem_get_gpio(dev, "cp-dump-int", GPIOD_IN, &pd->gpio_cp_dump_int) ?:
+	      modem_get_gpio(dev, "ap-dump-int", GPIOD_OUT_LOW, &pd->gpio_ap_dump_int) ?:
+	      /* set low unused gpios between AP and CP */
+	      modem_get_gpio(dev, "suspend-req", GPIOD_OUT_LOW, &suspend_req) ?:
+	      /* modem_link_pm_config_gpio() */
+	      modem_get_gpio(dev, "link-active", GPIOD_OUT_LOW, &pm->gpio_link_active) ?:
+	      modem_get_gpio(dev, "host-wakeup", GPIOD_IN, &pm->gpio_link_hostwake) ?:
+	      modem_get_gpio(dev, "slave-wakeup", GPIOD_OUT_LOW, &pm->gpio_link_slavewake);
+	if (ret)
+		return ret;
+
+	pd->name = "xmm6262";
+	pd->modem_type = IMC_XMM6262;
+	pd->link_types = LINKTYPE(LINKDEV_HSIC);
+	pd->modem_net = UMTS_NETWORK;
+	pd->use_handover = false;
+	pd->num_iodevs = ARRAY_SIZE(umts_io_devices);
+	pd->iodevs = umts_io_devices;
+	pd->link_pm_data = pm;
+	pd->gpio_revers_bias_clear = xmm_gpio_revers_bias_clear;
+	pd->gpio_revers_bias_restore = xmm_gpio_revers_bias_restore;
+
+	pm->name = "link_pm";
+	pm->link_reconnect = umts_link_reconnect;
+
+	return 0;
+}
+
+/* sipc4_modem.c */
+static struct modem_shared *create_modem_shared_data(struct device *dev)
+{
+	struct modem_shared *msd;
+
+	msd = devm_kzalloc(dev, sizeof(struct modem_shared), GFP_KERNEL);
+	if (!msd)
+		return NULL;
+
+	/* initialize link device list */
+	INIT_LIST_HEAD(&msd->link_dev_list);
+
+	/* initialize tree of io devices */
+	msd->iodevs_tree_chan = RB_ROOT;
+	msd->iodevs_tree_fmt = RB_ROOT;
+	spin_lock_init(&msd->lock);
+
+	return msd;
+}
+
+static struct modem_ctl *create_modemctl_device(struct platform_device *pdev,
+		struct modem_shared *msd)
+{
+	int ret = 0;
+	struct modem_data *pdata;
+	struct modem_ctl *modemctl;
+	struct device *dev = &pdev->dev;
+
+	/* create modem control device */
+	modemctl = devm_kzalloc(dev, sizeof(struct modem_ctl), GFP_KERNEL);
+	if (!modemctl)
+		return NULL;
+
+	modemctl->msd = msd;
+	modemctl->dev = dev;
+	modemctl->phone_state = STATE_OFFLINE;
+
+	pdata = pdev->dev.platform_data;
+	modemctl->mdm_data = pdata;
+	modemctl->name = pdata->name;
+
+	/* init modemctl device for getting modemctl operations */
+	ret = xmm6262_init_modemctl_device(modemctl, pdata);
+	if (ret)
+		return NULL;
+
+	mif_info("%s is created!!!\n", pdata->name);
+
+	return modemctl;
+}
+
+static struct io_device *create_io_device(struct device *dev,
+		struct modem_io_t *io_t, struct modem_shared *msd,
+		struct modem_ctl *modemctl, struct modem_data *pdata)
+{
+	int ret = 0;
+	struct io_device *iod = NULL;
+
+	iod = devm_kzalloc(dev, sizeof(struct io_device), GFP_KERNEL);
+	if (!iod) {
+		mif_err("iod == NULL\n");
+		return NULL;
+	}
+
+	RB_CLEAR_NODE(&iod->node_chan);
+	RB_CLEAR_NODE(&iod->node_fmt);
+
+	iod->name = io_t->name;
+	iod->id = io_t->id;
+	iod->format = io_t->format;
+	iod->io_typ = io_t->io_type;
+	iod->link_types = io_t->links;
+	iod->net_typ = pdata->modem_net;
+	iod->use_handover = pdata->use_handover;
+	iod->ipc_version = pdata->ipc_version;
+	atomic_set(&iod->opened, 0);
+
+	/* link between io device and modem control */
+	iod->mc = modemctl;
+	if (iod->format == IPC_FMT)
+		modemctl->iod = iod;
+	if (iod->format == IPC_BOOT) {
+		modemctl->bootd = iod;
+		mif_info("Boot device = %s\n", iod->name);
+	}
+
+	/* link between io device and modem shared */
+	iod->msd = msd;
+
+	/* add iod to rb_tree */
+	if (iod->format != IPC_RAW)
+		insert_iod_with_format(msd, iod->format, iod);
+
+	if (sipc4_is_not_reserved_channel(iod->id))
+		insert_iod_with_channel(msd, iod->id, iod);
+
+	/* register misc device or net device */
+	ret = sipc4_init_io_device(iod);
+	if (ret) {
+		mif_err("sipc4_init_io_device fail (%d)\n", ret);
+		return NULL;
+	}
+
+	mif_debug("%s is created!!!\n", iod->name);
+	return iod;
+}
+
+static int attach_devices(struct io_device *iod, enum modem_link tx_link)
+{
+	struct modem_shared *msd = iod->msd;
+	struct link_device *ld;
+
+	/* find link type for this io device */
+	list_for_each_entry(ld, &msd->link_dev_list, list) {
+		if (IS_CONNECTED(iod, ld)) {
+			if ((countbits(iod->link_types) <= 1) ||
+					(tx_link == ld->link_type)) {
+				mif_debug("set %s->%s\n", iod->name, ld->name);
+				set_current_link(iod, ld);
+			}
+		}
+	}
+
+	if (!get_current_link(iod)) {
+		mif_err("%s->link == NULL\n", iod->name);
+		return -ENODEV;
+	}
+
+	switch (iod->format) {
+	case IPC_FMT:
+		wake_lock_init(&iod->wakelock, WAKE_LOCK_SUSPEND, iod->name);
+		iod->waketime = FMT_WAKE_TIME;
+		break;
+
+	case IPC_RFS:
+		wake_lock_init(&iod->wakelock, WAKE_LOCK_SUSPEND, iod->name);
+		iod->waketime = RFS_WAKE_TIME;
+		break;
+
+	case IPC_MULTI_RAW:
+		wake_lock_init(&iod->wakelock, WAKE_LOCK_SUSPEND, iod->name);
+		iod->waketime = RAW_WAKE_TIME;
+		break;
+
+	case IPC_BOOT:
+		wake_lock_init(&iod->wakelock, WAKE_LOCK_SUSPEND, iod->name);
+		iod->waketime = 3 * HZ;
+		break;
+
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+static int modem_probe(struct platform_device *pdev)
+{
+	int i, ret;
+	struct device *dev = &pdev->dev;
+	struct modem_data *pdata = &umts_modem_data;
+	struct modem_shared *msd;
+	struct modem_ctl *modemctl;
+	struct io_device *iod;
+	struct link_device *ld;
+
+	ret = modem_parse_dt(dev);
+	if (ret)
+		return ret;
+	ret = modem_register_hci_compat(dev);
+	if (ret)
+		return ret;
+	pdev->dev.platform_data = pdata;
+
+	msd = create_modem_shared_data(dev);
+	if (!msd)
+		return -ENOMEM;
+
+	modemctl = create_modemctl_device(pdev, msd);
+	if (!modemctl)
+		return -ENOMEM;
+
+	/* create link device */
+	ld = hsic_create_link_device(pdev);
+	if (!ld)
+		return -ENOMEM;
+	mif_info("link created: %s\n", ld->name);
+	ld->link_type = LINKDEV_HSIC;
+	ld->mc = modemctl;
+	ld->msd = msd;
+	list_add(&ld->list, &msd->link_dev_list);
+
+	/* create io devices and connect to modemctl device */
+	for (i = 0; i < pdata->num_iodevs; i++) {
+		iod = create_io_device(dev, &pdata->iodevs[i], msd, modemctl,
+				       pdata);
+		if (!iod) {
+			mif_err("iod[%d] == NULL\n", i);
+			return -ENOMEM;
+		}
+
+		ret = attach_devices(iod, pdata->iodevs[i].tx_link);
+		if (ret)
+			return ret;
+	}
+
+	platform_set_drvdata(pdev, modemctl);
+
+	mif_info("Complete!!!\n");
+	return 0;
+}
+
+static void modem_shutdown(struct platform_device *pdev)
+{
+	struct modem_ctl *mc = platform_get_drvdata(pdev);
+
+	if (!mc)
+		return;
+	mc->ops.modem_off(mc);
+	mc->phone_state = STATE_OFFLINE;
+}
+
+static const struct of_device_id modem_of_match[] = {
+	{ .compatible = "samsung,n7100-modem-xmm6262" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, modem_of_match);
+
+static struct platform_driver modem_driver = {
+	.probe = modem_probe,
+	.shutdown = modem_shutdown,
+	.driver = {
+		.name = "modem_if",
+		.of_match_table = modem_of_match,
+		/* char devices, net devices and a USB driver hang off it */
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(modem_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Samsung Modem Interface Driver (XMM6262 over HSIC)");
diff --git a/drivers/misc/modem_if/modem_modemctl_device_xmm6262.c b/drivers/misc/modem_if/modem_modemctl_device_xmm6262.c
new file mode 100755
index 000000000..b5a8ae4d8
--- /dev/null
+++ b/drivers/misc/modem_if/modem_modemctl_device_xmm6262.c
@@ -0,0 +1,359 @@
+/* /linux/drivers/misc/modem_if/modem_modemctl_device_xmm6262.c
+ *
+ * Copyright (C) 2010 Google, Inc.
+ * Copyright (C) 2010 Samsung Electronics.
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation, and
+ * may be copied, distributed, and modified under those terms.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ */
+
+#define DEBUG
+
+#include <linux/init.h>
+#include <linux/irq.h>
+#include <linux/interrupt.h>
+#include <linux/gpio.h>
+#include <linux/delay.h>
+#include <linux/platform_device.h>
+#include "modem.h"
+#include "modem_prj.h"
+#ifdef CONFIG_FAST_BOOT
+#include <linux/fake_shut_down.h>
+#endif
+static int xmm6262_on(struct modem_ctl *mc)
+{
+	mif_info("\n");
+
+	if (!mc->gpio_cp_reset || !mc->gpio_cp_on || !mc->gpio_reset_req_n) {
+		mif_err("no gpio data\n");
+		return -ENXIO;
+	}
+
+	if (mc->gpio_revers_bias_clear)
+		mc->gpio_revers_bias_clear();
+
+#ifdef CONFIG_SEC_DUAL_MODEM_MODE
+	gpio_set_value(mc->gpio_sim_io_sel, 0);
+	gpio_set_value(mc->gpio_cp_ctrl1, 1);
+	gpio_set_value(mc->gpio_cp_ctrl2, 0);
+#endif
+
+	/* TODO */
+	gpio_set_value(mc->gpio_reset_req_n, 0);
+	gpio_set_value(mc->gpio_cp_on, 0);
+	gpio_set_value(mc->gpio_cp_reset, 0);
+	msleep(100);
+	gpio_set_value(mc->gpio_cp_reset, 1);
+	/* If XMM6262 was connected with C2C, AP wait 50ms to BB Reset*/
+	msleep(50);
+	gpio_set_value(mc->gpio_reset_req_n, 1);
+
+	gpio_set_value(mc->gpio_cp_on, 1);
+	udelay(60);
+	gpio_set_value(mc->gpio_cp_on, 0);
+	msleep(20);
+
+	mc->phone_state = STATE_BOOTING;
+
+	if (mc->gpio_revers_bias_restore)
+		mc->gpio_revers_bias_restore();
+	gpio_set_value(mc->gpio_pda_active, 1);
+
+
+	return 0;
+}
+
+static int xmm6262_off(struct modem_ctl *mc)
+{
+	mif_info("\n");
+
+	if (!mc->gpio_cp_reset || !mc->gpio_cp_on) {
+		mif_err("no gpio data\n");
+		return -ENXIO;
+	}
+
+	gpio_set_value(mc->gpio_cp_on, 0);
+	gpio_set_value(mc->gpio_cp_reset, 0);
+
+	return 0;
+}
+
+static int xmm6262_reset(struct modem_ctl *mc)
+{
+	mif_info("\n");
+
+	if (!mc->gpio_cp_reset || !mc->gpio_reset_req_n)
+		return -ENXIO;
+
+	if (mc->gpio_revers_bias_clear)
+		mc->gpio_revers_bias_clear();
+
+	gpio_set_value(mc->gpio_cp_reset, 0);
+	gpio_set_value(mc->gpio_reset_req_n, 0);
+
+	mc->phone_state = STATE_OFFLINE;
+
+	msleep(20);
+
+	gpio_set_value(mc->gpio_cp_reset, 1);
+	/* TODO: check the reset timming with C2C connection */
+	udelay(160);
+
+	gpio_set_value(mc->gpio_reset_req_n, 1);
+	udelay(100);
+
+	gpio_set_value(mc->gpio_cp_on, 1);
+	udelay(60);
+	gpio_set_value(mc->gpio_cp_on, 0);
+	msleep(20);
+
+	if (mc->gpio_revers_bias_restore)
+		mc->gpio_revers_bias_restore();
+
+	mc->phone_state = STATE_BOOTING;
+
+	return 0;
+}
+
+static int xmm6262_force_crash_exit(struct modem_ctl *mc)
+{
+	mif_info("\n");
+
+	if (!mc->gpio_ap_dump_int)
+		return -ENXIO;
+	
+	gpio_set_value(mc->gpio_ap_dump_int, 1);
+	mif_info("set ap_dump_int(%d) to high=%d\n",
+		mc->gpio_ap_dump_int, gpio_get_value(mc->gpio_ap_dump_int));
+	return 0;
+}
+
+
+static irqreturn_t phone_active_irq_handler(int irq, void *_mc)
+{
+	int phone_reset = 0;
+	int phone_active_value = 0;
+	int cp_dump_value = 0;
+	int phone_state = 0;
+	struct modem_ctl *mc = (struct modem_ctl *)_mc;
+
+	disable_irq_nosync(mc->irq_phone_active);
+
+	if (!mc->gpio_cp_reset || !mc->gpio_phone_active ||
+			!mc->gpio_cp_dump_int) {
+		mif_err("no gpio data\n");
+		return IRQ_HANDLED;
+	}
+
+	phone_reset = gpio_get_value(mc->gpio_cp_reset);
+	phone_active_value = gpio_get_value(mc->gpio_phone_active);
+	cp_dump_value = gpio_get_value(mc->gpio_cp_dump_int);
+
+	mif_info("PA EVENT : reset =%d, pa=%d, cp_dump=%d\n",
+				phone_reset, phone_active_value, cp_dump_value);
+
+	if (phone_reset && phone_active_value) {
+		phone_state = STATE_BOOTING;
+	} else if (mc->dev->power.is_suspended && !phone_active_value) {
+		/*fixing dpm timeout by port2 resume retry*/
+		mif_err("CP reset while dpm resume\n");
+		xmm6262_off(mc);
+		phone_state = STATE_CRASH_RESET;
+	} else if (phone_reset && !phone_active_value) {
+		phone_state =
+			(cp_dump_value) ? STATE_CRASH_EXIT : STATE_CRASH_RESET;
+	} else {
+		phone_state = STATE_OFFLINE;
+	}
+
+	if (mc->iod && mc->iod->modem_state_changed)
+		mc->iod->modem_state_changed(mc->iod, phone_state);
+
+	if (mc->bootd && mc->bootd->modem_state_changed)
+		mc->bootd->modem_state_changed(mc->bootd, phone_state);
+
+	if (phone_active_value)
+		irq_set_irq_type(mc->irq_phone_active, IRQ_TYPE_LEVEL_LOW);
+	else
+		irq_set_irq_type(mc->irq_phone_active, IRQ_TYPE_LEVEL_HIGH);
+	enable_irq(mc->irq_phone_active);
+
+	return IRQ_HANDLED;
+}
+
+#ifdef CONFIG_FAST_BOOT
+#include <linux/reboot.h>
+
+static void mif_sim_detect_complete(struct modem_ctl *mc)
+{
+	if (mc->sim_shutdown_req) {
+		mif_info("fake shutdown sim changed shutdown\n");
+		kernel_power_off();
+		/*kernel_restart(NULL);*/
+		mc->sim_shutdown_req = false;
+	}
+}
+
+static int mif_init_sim_shutdown(struct modem_ctl *mc)
+{
+	mc->sim_shutdown_req = false;
+	mc->modem_complete = mif_sim_detect_complete;
+
+	return 0;
+}
+
+static void mif_check_fake_shutdown(struct modem_ctl *mc, bool online)
+{
+	if (fake_shut_down && mc->sim_state.online != online)
+		mc->sim_shutdown_req = true;
+}
+
+#else
+static inline int mif_init_sim_shutdown(struct modem_ctl *mc) { return 0; }
+#define mif_check_fake_shutdown(a, b) do {} while (0)
+#endif
+
+
+#define SIM_DETECT_DEBUG
+static irqreturn_t sim_detect_irq_handler(int irq, void *_mc)
+{
+	struct modem_ctl *mc = (struct modem_ctl *)_mc;
+#ifdef SIM_DETECT_DEBUG
+	int val = gpio_get_value(mc->gpio_sim_detect);
+	static int unchange;
+	static int prev_val;
+
+	if (mc->phone_state == STATE_BOOTING) {
+		mif_info("BOOTING, reset unchange\n");
+		unchange = 0;
+	}
+
+	if (prev_val == val) {
+		if (unchange++ > 50) {
+			mif_err("Abnormal SIM detect GPIO irqs");
+			disable_irq_nosync(mc->gpio_sim_detect);
+			panic("SIM detect IRQ Error");
+		}
+	} else {
+		unchange = 0;
+	}
+	prev_val = val;
+#endif
+	if (mc->iod && mc->iod->sim_state_changed) {
+		mif_check_fake_shutdown(mc,
+			gpio_get_value(mc->gpio_sim_detect) == mc->sim_polarity
+			);
+		mc->iod->sim_state_changed(mc->iod,
+			gpio_get_value(mc->gpio_sim_detect) == mc->sim_polarity
+			);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static void xmm6262_get_ops(struct modem_ctl *mc)
+{
+	mc->ops.modem_on = xmm6262_on;
+	mc->ops.modem_off = xmm6262_off;
+	mc->ops.modem_reset = xmm6262_reset;
+	mc->ops.modem_force_crash_exit = xmm6262_force_crash_exit;
+}
+
+int xmm6262_init_modemctl_device(struct modem_ctl *mc,
+			struct modem_data *pdata)
+{
+	int ret = 0;
+	struct platform_device *pdev;
+
+	mc->gpio_reset_req_n = pdata->gpio_reset_req_n;
+	mc->gpio_cp_on = pdata->gpio_cp_on;
+	mc->gpio_cp_reset = pdata->gpio_cp_reset;
+	mc->gpio_pda_active = pdata->gpio_pda_active;
+	mc->gpio_phone_active = pdata->gpio_phone_active;
+	mc->gpio_cp_dump_int = pdata->gpio_cp_dump_int;
+	mc->gpio_ap_dump_int = pdata->gpio_ap_dump_int;
+	mc->gpio_flm_uart_sel = pdata->gpio_flm_uart_sel;
+	mc->gpio_cp_warm_reset = pdata->gpio_cp_warm_reset;
+	mc->gpio_sim_detect = pdata->gpio_sim_detect;
+	mc->sim_polarity = pdata->sim_polarity;
+
+	mc->gpio_revers_bias_clear = pdata->gpio_revers_bias_clear;
+	mc->gpio_revers_bias_restore = pdata->gpio_revers_bias_restore;
+
+#ifdef CONFIG_SEC_DUAL_MODEM_MODE
+	mc->gpio_sim_io_sel = pdata->gpio_sim_io_sel;
+	mc->gpio_cp_ctrl1 = pdata->gpio_cp_ctrl1;
+	mc->gpio_cp_ctrl2 = pdata->gpio_cp_ctrl2;
+#endif
+
+
+	pdev = to_platform_device(mc->dev);
+	mc->irq_phone_active = gpio_to_irq(mc->gpio_phone_active);
+
+	if (mc->gpio_sim_detect)
+		mc->irq_sim_detect = gpio_to_irq(mc->gpio_sim_detect);
+
+	xmm6262_get_ops(mc);
+
+	ret = request_irq(mc->irq_phone_active, phone_active_irq_handler,
+				IRQF_TRIGGER_HIGH,
+				"phone_active", mc);
+	if (ret) {
+		mif_err("failed to request_irq:%d\n", ret);
+		goto err_phone_active_request_irq;
+	}
+
+	ret = enable_irq_wake(mc->irq_phone_active);
+	if (ret) {
+		mif_err("failed to enable_irq_wake:%d\n", ret);
+		goto err_phone_active_set_wake_irq;
+	}
+
+	/* initialize sim_state if gpio_sim_detect exists */
+	mc->sim_state.online = false;
+	mc->sim_state.changed = false;
+	if (mc->gpio_sim_detect) {
+		ret = request_irq(mc->irq_sim_detect, sim_detect_irq_handler,
+				IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
+				"sim_detect", mc);
+		if (ret) {
+			mif_err("failed to request_irq: %d\n", ret);
+			goto err_sim_detect_request_irq;
+		}
+
+		ret = enable_irq_wake(mc->irq_sim_detect);
+		if (ret) {
+			mif_err("failed to enable_irq_wake: %d\n", ret);
+			goto err_sim_detect_set_wake_irq;
+		}
+
+		/* initialize sim_state => insert: gpio=0, remove: gpio=1 */
+		mc->sim_state.online =
+			gpio_get_value(mc->gpio_sim_detect) == mc->sim_polarity;
+
+		ret = mif_init_sim_shutdown(mc);
+		if (ret) {
+			mif_err("failed to sim fake shutdown init: %d\n", ret);
+			goto err_sim_detect_set_wake_irq;
+		}
+	}
+
+	return ret;
+
+err_sim_detect_set_wake_irq:
+	free_irq(mc->irq_sim_detect, mc);
+err_sim_detect_request_irq:
+	mc->sim_state.online = false;
+	mc->sim_state.changed = false;
+err_phone_active_set_wake_irq:
+	free_irq(mc->irq_phone_active, mc);
+err_phone_active_request_irq:
+	return ret;
+}
