diff --git a/arch/arm/boot/dts/samsung/exynos4412-n710x.dtsi b/arch/arm/boot/dts/samsung/exynos4412-n710x.dtsi
index 66b984a8e..8fe55e0e7 100644
--- a/arch/arm/boot/dts/samsung/exynos4412-n710x.dtsi
+++ b/arch/arm/boot/dts/samsung/exynos4412-n710x.dtsi
@@ -44,6 +44,26 @@ cam_vdda_reg: voltage-regulator-10 {
 		gpio = <&gpm4 1 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 	};
+
+	/* Intel/Infineon XMM6262 3G modem on HSIC0 (Samsung modem_if, board-m0-modems.c) */
+	modem {
+		compatible = "samsung,n7100-modem-xmm6262";
+		samsung,hsic-host = <&ehci>;
+		/* the CP's 32 kHz sleep clock: without it the firmware hangs after the boot ROM stage */
+		clocks = <&max77686 MAX77686_CLK_CP>;
+		clock-names = "cp";
+		cp-on-gpios = <&gpl2 5 GPIO_ACTIVE_HIGH>;
+		reset-req-gpios = <&gpm3 3 GPIO_ACTIVE_HIGH>;
+		cp-reset-gpios = <&gpx3 2 GPIO_ACTIVE_HIGH>;
+		pda-active-gpios = <&gpf1 6 GPIO_ACTIVE_HIGH>;
+		phone-active-gpios = <&gpx1 6 GPIO_ACTIVE_HIGH>;
+		cp-dump-int-gpios = <&gpx1 2 GPIO_ACTIVE_HIGH>;
+		ap-dump-int-gpios = <&gpj0 1 GPIO_ACTIVE_HIGH>;
+		suspend-req-gpios = <&gpm2 4 GPIO_ACTIVE_HIGH>;
+		link-active-gpios = <&gpf1 1 GPIO_ACTIVE_HIGH>;
+		host-wakeup-gpios = <&gpx1 1 GPIO_ACTIVE_HIGH>;
+		slave-wakeup-gpios = <&gpx1 0 GPIO_ACTIVE_HIGH>;
+	};
 };
 
