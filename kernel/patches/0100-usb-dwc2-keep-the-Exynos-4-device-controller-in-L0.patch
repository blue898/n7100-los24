From b625d41015060a66edb0d822f2425dd5b8d5da33 Mon Sep 17 00:00:00 2001
From: leo <leoschlosser@tutamail.com>
Date: Sun, 1 Nov 2026 20:00:36 +0100
Subject: [PATCH 100/102] usb: dwc2: keep the Exynos 4 device controller in L0

On the Exynos 4412 (GT-N7100) the gadget does not survive a bus suspend (L2) or an LPM
L1: dwc2 keeps lx_state != L0 afterwards and rejects every request with -EAGAIN. A
session end or session request interrupt seen while the cable is still plugged in
takes it to L3 the same way. USB stays dead until the UDC is re-bound.

Add a keep_l0 parameter that keeps those interrupts masked whatever path programs
GINTMSK, and set it, with LPM off, for samsung,s3c6400-hsotg. This replaces a
userspace daemon that re-masked them through /dev/mem every 10 ms.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/usb/dwc2/core.h   | 15 +++++++++++++++
 drivers/usb/dwc2/params.c | 10 ++++++++++
 2 files changed, 25 insertions(+)

diff --git a/drivers/usb/dwc2/core.h b/drivers/usb/dwc2/core.h
index 767251aa1..3e331bf0a 100644
--- a/drivers/usb/dwc2/core.h
+++ b/drivers/usb/dwc2/core.h
@@ -367,6 +367,12 @@ enum dwc2_ep0_state {
  * @no_clock_gating:	Specifies whether to avoid clock gating feature.
  *			0 - No (use clock gating)
  *			1 - Yes (avoid it)
+ * @keep_l0:		Never unmask the interrupts that take the device controller out
+ *			of L0 (bus suspend, LPM, session end/request, ID change).
+ *			For controllers that don't come back from L1/L2 or treat a
+ *			spurious session end as a disconnect (Exynos 4).
+ *			0 - No
+ *			1 - Yes
  * @lpm:		Enable LPM support.
  *			0 - No
  *			1 - Yes
@@ -466,6 +472,7 @@ struct dwc2_core_params {
 #define DWC2_POWER_DOWN_PARAM_PARTIAL		1
 #define DWC2_POWER_DOWN_PARAM_HIBERNATION	2
 	bool no_clock_gating;
+	bool keep_l0;
 
 	bool lpm;
 	bool lpm_clock_gating;
@@ -1240,8 +1247,16 @@ static inline u32 dwc2_readl(struct dwc2_hsotg *hsotg, u32 offset)
 		return val;
 }
 
+#define DWC2_KEEP_L0_INTS	(GINTSTS_OTGINT | GINTSTS_USBSUSP |		\
+				 GINTSTS_LPMTRANRCVD | GINTSTS_CONIDSTSCHNG |	\
+				 GINTSTS_SESSREQINT)
+
 static inline void dwc2_writel(struct dwc2_hsotg *hsotg, u32 value, u32 offset)
 {
+	/* every path that (re)programs GINTMSK, constant-folded away for the other registers */
+	if (offset == GINTMSK && hsotg->params.keep_l0)
+		value &= ~DWC2_KEEP_L0_INTS;
+
 	if (hsotg->needs_byte_swap)
 		writel(swab32(value), hsotg->regs + offset);
 	else
diff --git a/drivers/usb/dwc2/params.c b/drivers/usb/dwc2/params.c
index 091bfcfef..4e1e98325 100644
--- a/drivers/usb/dwc2/params.c
+++ b/drivers/usb/dwc2/params.c
@@ -104,6 +104,16 @@ static void dwc2_set_s3c6400_params(struct dwc2_hsotg *hsotg)
 	p->power_down = DWC2_POWER_DOWN_PARAM_NONE;
 	p->no_clock_gating = true;
 	p->phy_utmi_width = 8;
+	/*
+	 * Exynos 4: after a bus suspend (L2) or an LPM L1 the gadget never returns to L0 and
+	 * rejects every request with -EAGAIN; a session end/request seen while the cable is
+	 * still in drops it to L3. Either way USB is dead until it is re-bound.
+	 */
+	p->keep_l0 = true;
+	p->lpm = false;
+	p->lpm_clock_gating = false;
+	p->besl = false;
+	p->hird_threshold_en = false;
 }
 
 static void dwc2_set_socfpga_agilex_params(struct dwc2_hsotg *hsotg)
-- 
