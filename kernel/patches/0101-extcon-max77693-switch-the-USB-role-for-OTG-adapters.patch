From 8ea3e116ad702230ea92c4294c25899d82b6e77d Mon Sep 17 00:00:00 2001
From: leo <leoschlosser@tutamail.com>
Date: Sun, 1 Nov 2026 20:05:56 +0100
Subject: [PATCH 101/102] extcon: max77693: switch the USB role for OTG
 adapters

The MUIC sees an OTG adapter (USB_HOST) and the charger then turns on the
5 V boost, but nothing told the USB controller: dwc2 stayed a device.
Look up the role switch behind the connector graph (midas: hsotg with
usb-role-switch) on first use and make it the host while USB_HOST is
attached, the device otherwise.

dwc2 switches roles from its connector ID change interrupt, raised by
the forced mode. keep_l0 keeps that interrupt masked, so run what its
handler does right away.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/extcon/Kconfig           |  1 +
 drivers/extcon/extcon-max77693.c | 51 ++++++++++++++++++++++++++++++++
 drivers/usb/dwc2/drd.c           | 10 ++++++-
 3 files changed, 61 insertions(+), 1 deletion(-)

diff --git a/drivers/extcon/Kconfig b/drivers/extcon/Kconfig
index 68d9df7d2..bca91d882 100644
--- a/drivers/extcon/Kconfig
+++ b/drivers/extcon/Kconfig
@@ -108,6 +108,7 @@ config EXTCON_MAX3355
 config EXTCON_MAX77693
 	tristate "Maxim MAX77693 EXTCON Support"
 	depends on MFD_MAX77693 && INPUT
+	depends on USB_ROLE_SWITCH || !USB_ROLE_SWITCH
 	select IRQ_DOMAIN
 	select REGMAP_I2C
 	help
diff --git a/drivers/extcon/extcon-max77693.c b/drivers/extcon/extcon-max77693.c
index da1407409..d4c84797b 100644
--- a/drivers/extcon/extcon-max77693.c
+++ b/drivers/extcon/extcon-max77693.c
@@ -20,6 +20,7 @@
 #include <linux/extcon-provider.h>
 #include <linux/regmap.h>
 #include <linux/irqdomain.h>
+#include <linux/usb/role.h>
 
 #define	DEV_NAME			"max77693-muic"
 #define	DELAY_MS_DEFAULT		20000		/* unit: millisecond */
@@ -94,6 +95,10 @@ struct max77693_muic_info {
 	 */
 	int path_usb;
 	int path_uart;
+
+	/* USB controller behind the connector, switched to host for an OTG adapter */
+	struct usb_role_switch *role_sw;
+	bool usb_host;
 };
 
 enum max77693_muic_cable_group {
@@ -933,6 +938,50 @@ static int max77693_muic_chg_handler(struct max77693_muic_info *info)
 	return 0;
 }
 
+static void max77693_muic_put_role_sw(void *data)
+{
+	usb_role_switch_put(data);
+}
+
+/*
+ * Make the USB controller the host while an OTG adapter (USB_HOST) is attached, the
+ * device otherwise. The switch is looked up on first use rather than at probe, so the
+ * MUIC (and the charger depending on it) doesn't wait for the USB controller.
+ */
+static void max77693_muic_update_role(struct max77693_muic_info *info)
+{
+	bool host = extcon_get_state(info->edev, EXTCON_USB_HOST) > 0;
+	struct fwnode_handle *connector;
+	struct usb_role_switch *sw;
+	int ret;
+
+	if (host == info->usb_host)
+		return;
+
+	if (!info->role_sw) {
+		connector = device_get_named_child_node(info->dev, "connector");
+		if (!connector)
+			return;
+		sw = fwnode_usb_role_switch_get(connector);
+		fwnode_handle_put(connector);
+		if (IS_ERR_OR_NULL(sw)) {
+			dev_warn(info->dev, "no USB role switch: %ld\n", PTR_ERR(sw));
+			return;
+		}
+		if (devm_add_action_or_reset(info->dev, max77693_muic_put_role_sw, sw))
+			return;
+		info->role_sw = sw;
+	}
+
+	ret = usb_role_switch_set_role(info->role_sw, host ? USB_ROLE_HOST : USB_ROLE_DEVICE);
+	if (ret) {
+		dev_err(info->dev, "failed to switch USB to %s: %d\n",
+			host ? "host" : "device", ret);
+		return;
+	}
+	info->usb_host = host;
+}
+
 static void max77693_muic_irq_work(struct work_struct *work)
 {
 	struct max77693_muic_info *info = container_of(work,
@@ -985,6 +1034,7 @@ static void max77693_muic_irq_work(struct work_struct *work)
 	if (ret < 0)
 		dev_err(info->dev, "failed to handle MUIC interrupt\n");
 
+	max77693_muic_update_role(info);
 out:
 	mutex_unlock(&info->mutex);
 }
@@ -1044,6 +1094,7 @@ static int max77693_muic_detect_accessory(struct max77693_muic_info *info)
 		}
 	}
 
+	max77693_muic_update_role(info);
 	mutex_unlock(&info->mutex);
 
 	return 0;
diff --git a/drivers/usb/dwc2/drd.c b/drivers/usb/dwc2/drd.c
index 1ad8fa3f8..9892845d5 100644
--- a/drivers/usb/dwc2/drd.c
+++ b/drivers/usb/dwc2/drd.c
@@ -156,10 +156,18 @@ static int dwc2_drd_role_sw_set(struct usb_role_switch *sw, enum usb_role role)
 
 	spin_unlock_irqrestore(&hsotg->lock, flags);
 
-	if (!already && hsotg->dr_mode == USB_DR_MODE_OTG)
+	if (!already && hsotg->dr_mode == USB_DR_MODE_OTG) {
 		/* This will raise a Connector ID Status Change Interrupt */
 		dwc2_force_mode(hsotg, role == USB_ROLE_HOST);
 
+		/* ...which keep_l0 keeps masked: do what its handler does */
+		if (hsotg->params.keep_l0 && hsotg->wq_otg) {
+			dwc2_writel(hsotg, GINTSTS_CONIDSTSCHNG, GINTSTS);
+			dwc2_writel(hsotg, dwc2_readl(hsotg, GINTMSK) & ~GINTSTS_SOF, GINTMSK);
+			queue_work(hsotg->wq_otg, &hsotg->wf_otg);
+		}
+	}
+
 	if (!hsotg->ll_hw_enabled && hsotg->clk)
 		clk_disable_unprepare(hsotg->clk);
 
-- 
2.53.0

