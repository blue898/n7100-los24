From 187e9c37f8de59e84d9b4a2d50abe118b41cc80b Mon Sep 17 00:00:00 2001
From: Martin Juecker <martin.juecker@gmail.com>
Date: Mon, 2 Nov 2026 08:07:20 +0100
Subject: [PATCH 108/112] media: exynos4-is: always power off FIMC-IS in
 s_power(0)

A sub-IP power-off timeout returned early, leaving the ISP CPU powered and the runtime PM
reference held, so every later open failed until a reboot. Warn and finish the power-off.

Taken from commit 6fb0cb9d in https://gitlab.com/martin.juecker/linux (branch v7.1.1-exynos4-camera).
Link: https://gitlab.com/exynos4-mainline/linux/-/merge_requests/28
---
 drivers/media/platform/samsung/exynos4-is/fimc-isp.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/samsung/exynos4-is/fimc-isp.c b/drivers/media/platform/samsung/exynos4-is/fimc-isp.c
index 3c5d7bee2..cdfea8669 100644
--- a/drivers/media/platform/samsung/exynos4-is/fimc-isp.c
+++ b/drivers/media/platform/samsung/exynos4-is/fimc-isp.c
@@ -340,10 +340,9 @@ static int fimc_isp_subdev_s_power(struct v4l2_subdev *sd, int on)
 			fimc_is_hw_subip_power_off(is);
 			ret = fimc_is_wait_event(is, IS_ST_PWR_SUBIP_ON, 0,
 						 FIMC_IS_CONFIG_TIMEOUT);
-			if (ret < 0) {
-				v4l2_err(sd, "sub-IP power off timeout\n");
-				return ret;
-			}
+			if (ret < 0)
+				v4l2_warn(sd, "sub-IP power off timeout, forcing CPU power-off\n");
+			ret = 0;
 		}
 
 		fimc_is_cpu_set_power(is, 0);
-- 
2.53.0

