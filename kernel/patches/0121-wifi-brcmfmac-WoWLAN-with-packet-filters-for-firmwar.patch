From af214b89eb3a36a373bc6693848be9984d0a03e2 Mon Sep 17 00:00:00 2001
From: leo <leoschlosser@tutamail.com>
Date: Tue, 3 Nov 2026 08:07:26 +0100
Subject: [PATCH 121/128] wifi: brcmfmac: WoWLAN with packet filters for
 firmware without it

Without WoWLAN triggers cfg80211 disconnects every interface before a
suspend, and brcmfmac offers no triggers when the firmware lacks the
"wowl" iovar, like the BCM4334 firmware of the Galaxy Note II. So the
phone dropped off Wi-Fi each time it went to deep sleep and nothing
reached it until it woke up by itself.

Broadcom's own driver stays associated in suspend instead and lets
packet filters decide what wakes the host. Do the same when the bus can
wake the host (wowl_supported: kept power and an out-of-band interrupt
or SDIO wake) but the firmware has no WoWLAN: offer the triggers "any"
and "disconnect", and when they are set and the interface is connected,
install filters that pass only unicast frames, ARP requests for the
interface's IPv4 address and IPv6 neighbour solicitations (the firmware
has ARP offload, but not the arp_ol mode or host IP list needed for it).
The firmware goes to maximum power save with every third DTIM and a
30 s keep-alive, and the bus keeps the wake interrupt armed. The
firmware's events, a lost link among them, wake the host as well.
Resume removes the filters and restores the power save mode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../broadcom/brcm80211/brcmfmac/cfg80211.c    | 155 +++++++++++++++---
 .../broadcom/brcm80211/brcmfmac/cfg80211.h    |   1 +
 2 files changed, 137 insertions(+), 19 deletions(-)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
index 872c48806..65395004a 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
@@ -7,6 +7,7 @@
 
 #include <linux/kernel.h>
 #include <linux/etherdevice.h>
+#include <linux/inetdevice.h>
 #include <linux/module.h>
 #include <linux/unaligned.h>
 #include <linux/vmalloc.h>
@@ -4174,6 +4175,122 @@ static void brcmf_report_wowl_wakeind(struct wiphy *wiphy, struct brcmf_if *ifp)
 
 #endif /* CONFIG_PM */
 
+static int brcmf_keepalive_start(struct brcmf_if *ifp, unsigned int interval)
+{
+	struct brcmf_mkeep_alive_pkt_le kalive = {0};
+	int ret = 0;
+
+	/* Configure Null function/data keepalive */
+	kalive.version = cpu_to_le16(1);
+	kalive.period_msec = cpu_to_le32(interval * MSEC_PER_SEC);
+	kalive.len_bytes = cpu_to_le16(0);
+	kalive.keep_alive_id = 0;
+
+	ret = brcmf_fil_iovar_data_set(ifp, "mkeep_alive", &kalive, sizeof(kalive));
+	if (ret)
+		brcmf_err("keep-alive packet config failed, ret=%d\n", ret);
+
+	return ret;
+}
+
+/*
+ * Firmware without WoWLAN (no "wowl" iovar, like the BCM4334 firmware of the
+ * Galaxy Note II) on a bus that can wake the host: WoWLAN "any" and
+ * "disconnect" (brcmf_wowlan_filtered), done the way Broadcom's own driver
+ * keeps the link in suspend. Packet filters pass only unicast frames, ARP
+ * requests for the interface's IPv4 address and IPv6 neighbour solicitations;
+ * the bus wakes the host for them (out-of-band interrupt), and for the
+ * firmware's events, a lost link among them.
+ */
+#define BRCMF_SUSPEND_FILTER_UNICAST	100
+#define BRCMF_SUSPEND_FILTER_ARP	101
+#define BRCMF_SUSPEND_FILTER_NS		102
+
+static void brcmf_suspend_filter_add(struct brcmf_if *ifp, u32 id, u32 offset,
+				     const u8 *mask, const u8 *pattern,
+				     u32 size)
+{
+	struct brcmf_pkt_filter_enable_le enable = {
+		.id = cpu_to_le32(id),
+		.enable = cpu_to_le32(1),
+	};
+	struct brcmf_pkt_filter_le *filter;
+	s32 err;
+	u32 len = offsetof(struct brcmf_pkt_filter_le,
+			   u.pattern.mask_and_pattern) + 2 * size;
+
+	filter = kzalloc(len, GFP_KERNEL);
+	if (!filter)
+		return;
+	filter->id = cpu_to_le32(id);
+	filter->u.pattern.offset = cpu_to_le32(offset);
+	filter->u.pattern.size_bytes = cpu_to_le32(size);
+	memcpy(filter->u.pattern.mask_and_pattern, mask, size);
+	memcpy(filter->u.pattern.mask_and_pattern + size, pattern, size);
+	err = brcmf_fil_iovar_data_set(ifp, "pkt_filter_add", filter, len);
+	if (!err)
+		err = brcmf_fil_iovar_data_set(ifp, "pkt_filter_enable", &enable,
+					       sizeof(enable));
+	if (err)
+		brcmf_err("packet filter %u failed: %d\n", id, err);
+	kfree(filter);
+}
+
+static void brcmf_suspend_keep_link_start(struct brcmf_cfg80211_info *cfg,
+					  struct brcmf_if *ifp)
+{
+	static const u8 unicast_mask[] = { 0x01 }, unicast[] = { 0x00 };
+	static const u8 ns_mask[] = { 0xff, 0xff, 0xff };
+	static const u8 ns[] = { 0x33, 0x33, 0xff };
+	/* From the EtherType to the ARP target protocol address */
+	u8 arp_mask[30] = { 0xff, 0xff }, arp[30] = { 0x08, 0x06 };
+	const struct in_ifaddr *ifa;
+	struct in_device *in_dev;
+	u32 id;
+
+	rcu_read_lock();
+	in_dev = __in_dev_get_rcu(ifp->ndev);
+	ifa = in_dev ? rcu_dereference(in_dev->ifa_list) : NULL;
+	if (ifa) {
+		memset(arp_mask + 26, 0xff, 4);
+		memcpy(arp + 26, &ifa->ifa_local, 4);
+	}
+	rcu_read_unlock();
+
+	/* Forward the frames that match a filter, drop the others */
+	for (id = BRCMF_SUSPEND_FILTER_UNICAST;
+	     id <= BRCMF_SUSPEND_FILTER_NS; id++)
+		brcmf_fil_iovar_int_set(ifp, "pkt_filter_delete", id);
+	brcmf_fil_iovar_int_set(ifp, "pkt_filter_mode", 1);
+	brcmf_suspend_filter_add(ifp, BRCMF_SUSPEND_FILTER_UNICAST, 0,
+				 unicast_mask, unicast, sizeof(unicast));
+	brcmf_suspend_filter_add(ifp, BRCMF_SUSPEND_FILTER_ARP, ETH_ALEN * 2,
+				 arp_mask, arp, sizeof(arp));
+	brcmf_suspend_filter_add(ifp, BRCMF_SUSPEND_FILTER_NS, 0,
+				 ns_mask, ns, sizeof(ns));
+
+	brcmf_fil_cmd_int_get(ifp, BRCMF_C_GET_PM, &cfg->wowl.pre_pmmode);
+	brcmf_fil_cmd_int_set(ifp, BRCMF_C_SET_PM, PM_MAX);
+	/* Wake up for every third DTIM beacon only */
+	brcmf_fil_iovar_int_set(ifp, "bcn_li_dtim", 3);
+	brcmf_keepalive_start(ifp, 30);
+	brcmf_bus_wowl_config(cfg->pub->bus_if, true);
+	cfg->wowl.link_kept = true;
+}
+
+static void brcmf_suspend_keep_link_stop(struct brcmf_cfg80211_info *cfg,
+					 struct brcmf_if *ifp)
+{
+	u32 id;
+
+	for (id = BRCMF_SUSPEND_FILTER_UNICAST;
+	     id <= BRCMF_SUSPEND_FILTER_NS; id++)
+		brcmf_fil_iovar_int_set(ifp, "pkt_filter_delete", id);
+	brcmf_fil_iovar_int_set(ifp, "bcn_li_dtim", 0);
+	brcmf_fil_cmd_int_set(ifp, BRCMF_C_SET_PM, cfg->wowl.pre_pmmode);
+	cfg->wowl.link_kept = false;
+}
+
 static s32 brcmf_cfg80211_resume(struct wiphy *wiphy)
 {
 	struct brcmf_cfg80211_info *cfg = wiphy_to_cfg(wiphy);
@@ -4182,6 +4299,9 @@ static s32 brcmf_cfg80211_resume(struct wiphy *wiphy)
 
 	brcmf_dbg(TRACE, "Enter\n");
 
+	if (cfg->wowl.link_kept)
+		brcmf_suspend_keep_link_stop(cfg, ifp);
+
 	if (cfg->wowl.active) {
 		brcmf_report_wowl_wakeind(wiphy, ifp);
 		brcmf_fil_iovar_int_set(ifp, "wowl_clear", 0);
@@ -4258,24 +4378,6 @@ static void brcmf_configure_wowl(struct brcmf_cfg80211_info *cfg,
 	cfg->wowl.active = true;
 }
 
-static int brcmf_keepalive_start(struct brcmf_if *ifp, unsigned int interval)
-{
-	struct brcmf_mkeep_alive_pkt_le kalive = {0};
-	int ret = 0;
-
-	/* Configure Null function/data keepalive */
-	kalive.version = cpu_to_le16(1);
-	kalive.period_msec = cpu_to_le32(interval * MSEC_PER_SEC);
-	kalive.len_bytes = cpu_to_le16(0);
-	kalive.keep_alive_id = 0;
-
-	ret = brcmf_fil_iovar_data_set(ifp, "mkeep_alive", &kalive, sizeof(kalive));
-	if (ret)
-		brcmf_err("keep-alive packet config failed, ret=%d\n", ret);
-
-	return ret;
-}
-
 static s32 brcmf_cfg80211_suspend(struct wiphy *wiphy,
 				  struct cfg80211_wowlan *wowl)
 {
@@ -4319,6 +4421,11 @@ static s32 brcmf_cfg80211_suspend(struct wiphy *wiphy,
 		/* Configure MPC */
 		brcmf_set_mpc(ifp, 1);
 
+	} else if (!brcmf_feat_is_enabled(ifp, BRCMF_FEAT_WOWL)) {
+		if (test_bit(BRCMF_VIF_STATUS_CONNECTED, &ifp->vif->sme_state))
+			brcmf_suspend_keep_link_start(cfg, ifp);
+		else
+			brcmf_bus_wowl_config(cfg->pub->bus_if, false);
 	} else {
 		/* Configure WOWL parameters */
 		brcmf_configure_wowl(cfg, ifp, wowl);
@@ -7623,6 +7730,11 @@ static const struct wiphy_wowlan_support brcmf_wowlan_support = {
 	.pattern_min_len = 1,
 	.max_pkt_offset = 1500,
 };
+
+/* Firmware without WoWLAN: packet filters (brcmf_suspend_keep_link_start()) */
+static const struct wiphy_wowlan_support brcmf_wowlan_filtered = {
+	.flags = WIPHY_WOWLAN_ANY | WIPHY_WOWLAN_DISCONNECT,
+};
 #endif
 
 static void brcmf_wiphy_wowl_params(struct wiphy *wiphy, struct brcmf_if *ifp)
@@ -7743,6 +7855,10 @@ static int brcmf_setup_wiphy(struct wiphy *wiphy, struct brcmf_if *ifp)
 
 	if (brcmf_feat_is_enabled(ifp, BRCMF_FEAT_WOWL))
 		brcmf_wiphy_wowl_params(wiphy, ifp);
+#ifdef CONFIG_PM
+	else if (ifp->drvr->bus_if->wowl_supported)
+		wiphy->wowlan = &brcmf_wowlan_filtered;
+#endif
 	err = brcmf_fil_cmd_data_get(ifp, BRCMF_C_GET_BANDLIST, &bandlist,
 				     sizeof(bandlist));
 	if (err) {
@@ -8322,7 +8438,8 @@ static void brcmf_free_wiphy(struct wiphy *wiphy)
 		kfree(wiphy->bands[NL80211_BAND_5GHZ]);
 	}
 #if IS_ENABLED(CONFIG_PM)
-	if (wiphy->wowlan != &brcmf_wowlan_support)
+	if (wiphy->wowlan != &brcmf_wowlan_support &&
+	    wiphy->wowlan != &brcmf_wowlan_filtered)
 		kfree(wiphy->wowlan);
 #endif
 }
diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.h b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.h
index 63e534523..7124e28dd 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.h
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.h
@@ -323,6 +323,7 @@ struct brcmf_cfg80211_vif_event {
  */
 struct brcmf_cfg80211_wowl {
 	bool active;
+	bool link_kept;
 	u32 pre_pmmode;
 	struct cfg80211_wowlan_nd_match *nd;
 	struct cfg80211_wowlan_nd_info *nd_info;
-- 
2.53.0

