 INIT_DUMB_DRIVER(evdi)
+/*
+ * exynos-drm (FIMD) planes only scan out RGB. Without SCANOUT the YUV buffers HWC would put on an
+ * overlay (camera preview, video) can be allocated; drm_hwcomposer composes them with the GPU.
+ */
+static void exynos_resolve_format_and_use_flags(struct driver *drv, uint32_t format,
+						uint64_t use_flags, uint32_t *out_format,
+						uint64_t *out_use_flags)
+{
+	drv_resolve_format_and_use_flags_helper(drv, format, use_flags, out_format, out_use_flags);
+	switch (*out_format) {
+	case DRM_FORMAT_NV12:
+	case DRM_FORMAT_NV21:
+	case DRM_FORMAT_YVU420:
+	case DRM_FORMAT_YVU420_ANDROID:
+		*out_use_flags &= ~BO_USE_SCANOUT;
+		break;
+	}
+}
+
+/*
+ * BLOBs (camera JPEG output) are R8 buffers one line high; drv_dumb_bo_create() aligns the height
+ * to 64 lines for llvmpipe, which turns a 5 MB JPEG buffer into a 320 MB allocation.
+ */
+static int exynos_bo_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t format,
+			    uint64_t use_flags)
+{
+	if (format == DRM_FORMAT_R8 && height == 1)
+		return drv_dumb_bo_create_ex(bo, width, height, format, use_flags,
+					     BO_QUIRK_DUMB32BPP);
+	return drv_dumb_bo_create(bo, width, height, format, use_flags);
+}
+
+const struct backend backend_exynos = {
+	.name = "exynos",
+	.init = dumb_driver_init,
+	.bo_create = exynos_bo_create,
+	.bo_create_with_modifiers = dumb_bo_create_with_modifiers,
+	.bo_destroy = drv_dumb_bo_destroy,
+	.bo_import = drv_prime_bo_import,
+	.bo_export = drv_prime_bo_export,
+	.bo_map = drv_dumb_bo_map,
+	.bo_unmap = drv_bo_munmap,
+	.resolve_format_and_use_flags = exynos_resolve_format_and_use_flags,
+};
+
 INIT_DUMB_DRIVER(komeda)
 INIT_DUMB_DRIVER(marvell)
 INIT_DUMB_DRIVER(meson)
