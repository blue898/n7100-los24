+#ifndef ANDROID_V4L2_CODEC2_V4L2_MFC_DECODER_H
+#define ANDROID_V4L2_CODEC2_V4L2_MFC_DECODER_H
+
+#include <stdint.h>
+
+#include <array>
+#include <map>
+#include <memory>
+#include <optional>
+#include <queue>
+#include <vector>
+
+#include <base/callback.h>
+#include <base/memory/weak_ptr.h>
+#include <base/sequenced_task_runner.h>
+
+#include <ui/Rect.h>
+#include <ui/Size.h>
+#include <v4l2_codec2/common/VideoTypes.h>
+#include <v4l2_codec2/components/VideoDecoder.h>
+#include <v4l2_codec2/components/VideoFrame.h>
+#include <v4l2_codec2/components/VideoFramePool.h>
+#include <v4l2_codec2/v4l2/V4L2Device.h>
+
+namespace android {
+
+// A stateful V4L2 decoder for devices that can't import buffers (Samsung's MFC v5, s5p-mfc:
+// MMAP only, and its frames are tiled NV12MT, which nothing else in Android reads). The
+// bitstream is copied into the device's buffers, every decoded frame is detiled into an NV12
+// graphic buffer from the frame pool and the device buffer goes straight back to the decoder.
+// The detiling runs on a FIMC memory-to-memory device (exynos4-is) when there is a free one,
+// else on the CPU.
+//
+// The MFC v5 can't resume after a drain (V4L2_DEC_CMD_STOP) or a flush, so those end the
+// session: the next decode() opens a new one and feeds it the stream's SPS/PPS first.
+class MfcDecoder : public VideoDecoder {
+public:
+    static std::unique_ptr<VideoDecoder> Create(
+            uint32_t debugStreamId, const VideoCodec& codec, const size_t inputBufferSize,
+            const size_t minNumOutputBuffers, GetPoolCB getPoolCb, OutputCB outputCb,
+            ErrorCB errorCb, scoped_refptr<::base::SequencedTaskRunner> taskRunner);
+    ~MfcDecoder() override;
+
+    void decode(std::unique_ptr<ConstBitstreamBuffer> buffer, DecodeCB decodeCb) override;
+    void drain(DecodeCB drainCb) override;
+    void flush() override;
+
+private:
+    struct DecodeRequest {
+        std::unique_ptr<ConstBitstreamBuffer> buffer;  // nullptr: drain
+        DecodeCB decodeCb;
+    };
+    struct DecodedFrame {
+        V4L2ReadableBufferRef buffer;
+        int32_t bitstreamId;
+    };
+
+    MfcDecoder(uint32_t debugStreamId, scoped_refptr<::base::SequencedTaskRunner> taskRunner);
+    bool start(const VideoCodec& codec, size_t inputBufferSize, size_t minNumOutputBuffers,
+               GetPoolCB getPoolCb, OutputCB outputCb, ErrorCB errorCb);
+
+    // Open the device and set up its bitstream side; the frame side follows once the header
+    // has been parsed.
+    bool openSession();
+    void closeSession();
+    bool setupOutput();
+
+    void pumpDecodeRequests();
+    bool queueBitstream(const uint8_t* data, size_t size, int32_t bitstreamId);
+    void serviceDeviceTask(bool event);
+    void fetchFrame();
+    void onFrameReady(std::optional<VideoFramePool::FrameWithBlockId> frameWithBlockId);
+    bool detileOnCpu(const DecodedFrame& decoded, VideoFrame* frame);
+
+    // FIMC: the decoder's frame buffers (exported) in, the graphic buffers out, both DMABUF
+    bool setupFimc();
+    bool openFimc(const std::string& path);
+    void closeFimc();
+    bool detileOnFimc(const DecodedFrame& decoded, VideoFrame* frame, uint32_t blockId);
+    bool requeueOutput(V4L2ReadableBufferRef buffer);
+    void finishDrain();
+    void onError();
+
+    const uint32_t mDebugStreamId;
+    scoped_refptr<::base::SequencedTaskRunner> mTaskRunner;
+
+    VideoCodec mCodec = VideoCodec::H264;
+    size_t mInputBufferSize = 0;
+    size_t mMinNumOutputBuffers = 0;
+    GetPoolCB mGetPoolCb;
+    OutputCB mOutputCb;
+    ErrorCB mErrorCb;
+
+    scoped_refptr<V4L2Device> mDevice;
+    scoped_refptr<V4L2Queue> mInputQueue;
+    scoped_refptr<V4L2Queue> mOutputQueue;
+    std::unique_ptr<VideoFramePool> mVideoFramePool;
+
+    std::queue<DecodeRequest> mDecodeRequests;
+    std::map<int32_t, DecodeCB> mPendingDecodeCbs;  // bitstream id -> callback
+    std::queue<DecodedFrame> mDecodedFrames;        // waiting for a graphic buffer
+    DecodeCB mDrainCb;
+    bool mDrainPending = false;  // the decoder has returned its last frame
+    bool mFetchingFrame = false;
+    bool mError = false;
+
+    // The stream's codec config (SPS/PPS), sent first in every session
+    std::vector<uint8_t> mCodecConfig;
+    bool mSessionFed = false;  // something was queued in this session
+
+    int mFimcFd = -1;
+    std::vector<std::array<int, 2>> mFrameDmabufs;
+
+    ui::Size mCodedSize;
+    Rect mVisibleRect;
+    size_t mLumaLines = 0, mChromaLines = 0, mStride = 0;
+
+    ::base::WeakPtr<MfcDecoder> mWeakThis;
+    ::base::WeakPtrFactory<MfcDecoder> mWeakThisFactory{this};
+};
+
+}  // namespace android
+
+#endif  // ANDROID_V4L2_CODEC2_V4L2_MFC_DECODER_H
diff --git a/v4l2/include/v4l2_codec2/v4l2/Nv12mt.h b/v4l2/include/v4l2_codec2/v4l2/Nv12mt.h
new file mode 100755
