+constexpr size_t kNumInputBuffers = 6;
+constexpr size_t kMinInputBufferSize = 1024 * 1024;
+constexpr size_t kMaxInputBufferSize = 4 * 1024 * 1024;  // the MFC v5's coded picture buffer
+// Bitstream id of the codec config this decoder queues itself (the component's ids are >= 0)
+constexpr int32_t kConfigBitstreamId = -2;
+// FIMC slots for the graphic buffers (by block id: a slot keeps its DMABUF mapped)
+constexpr uint32_t kFimcFrameSlots = 32;
+constexpr int kFimcTimeoutMs = 500;
+
+int xioctl(int fd, unsigned long request, void* arg) {
+    int ret;
+    do {
+        ret = ioctl(fd, request, arg);
+    } while (ret != 0 && errno == EINTR);
+    return ret;
+}
+
+// H.264 Annex B: is there a slice, and what are the parameter sets in |data|?
+struct NalScan {
+    bool slices = false;
+    std::vector<uint8_t> sps, pps;  // the last of each, with start code
+};
+
+NalScan scanH264(const uint8_t* data, size_t size) {
+    NalScan scan;
+    auto startCode = [&](size_t i) {
+        return i + 3 <= size && data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1;
+    };
+    size_t i = 0;
+    while (i + 3 <= size && !startCode(i)) i++;
+    while (i + 3 <= size) {
+        size_t nal = i + 3, next = nal;
+        while (next + 3 <= size && !startCode(next)) next++;
+        if (next + 3 > size) next = size;
+        size_t end = next;
+        while (end > nal && data[end - 1] == 0) end--;  // trailing zeros / 4-byte start code
+        if (nal < end) {
+            const int type = data[nal] & 0x1f;
+            if (type >= 1 && type <= 5) scan.slices = true;
+            std::vector<uint8_t> unit = {0, 0, 0, 1};
+            unit.insert(unit.end(), data + nal, data + end);
+            if (type == 7) scan.sps = std::move(unit);
+            if (type == 8) scan.pps = std::move(unit);
+        }
+        i = next;
+    }
+    return scan;
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<VideoDecoder> MfcDecoder::Create(
+        uint32_t debugStreamId, const VideoCodec& codec, const size_t inputBufferSize,
+        const size_t minNumOutputBuffers, GetPoolCB getPoolCb, OutputCB outputCb,
+        ErrorCB errorCb, scoped_refptr<::base::SequencedTaskRunner> taskRunner) {
+    std::unique_ptr<MfcDecoder> decoder =
+            ::base::WrapUnique<MfcDecoder>(new MfcDecoder(debugStreamId, taskRunner));
+    if (!decoder->start(codec, inputBufferSize, minNumOutputBuffers, std::move(getPoolCb),
+                        std::move(outputCb), std::move(errorCb))) {
+        return nullptr;
+    }
+    return decoder;
+}
+
+MfcDecoder::MfcDecoder(uint32_t debugStreamId,
+                       scoped_refptr<::base::SequencedTaskRunner> taskRunner)
+      : mDebugStreamId(debugStreamId), mTaskRunner(std::move(taskRunner)) {
+    mWeakThis = mWeakThisFactory.GetWeakPtr();
+}
+
+MfcDecoder::~MfcDecoder() {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+    mWeakThisFactory.InvalidateWeakPtrs();
+    closeSession();
+}
+
+bool MfcDecoder::start(const VideoCodec& codec, size_t inputBufferSize,
+                       size_t minNumOutputBuffers, GetPoolCB getPoolCb, OutputCB outputCb,
+                       ErrorCB errorCb) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+    if (codec != VideoCodec::H264) {
+        ALOGE("%s: only H.264", __func__);
+        return false;
+    }
+    mCodec = codec;
+    mInputBufferSize = std::clamp(inputBufferSize, kMinInputBufferSize, kMaxInputBufferSize);
+    mMinNumOutputBuffers = minNumOutputBuffers;
+    mGetPoolCb = std::move(getPoolCb);
+    mOutputCb = std::move(outputCb);
+    mErrorCb = std::move(errorCb);
+    return openSession();
+}
+
+bool MfcDecoder::openSession() {
+    mDevice = V4L2Device::create(mDebugStreamId);
+    const uint32_t pixfmt = V4L2Device::videoCodecToPixFmt(mCodec);
+    if (!mDevice->open(V4L2Device::Type::kDecoder, pixfmt)) {
+        ALOGE("%s: no decoder for %s", __func__, VideoCodecToString(mCodec));
+        mDevice = nullptr;
+        return false;
+    }
+    mInputQueue = mDevice->getQueue(V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+    mOutputQueue = mDevice->getQueue(V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+    if (!mInputQueue || !mOutputQueue ||
+        !mInputQueue->setFormat(pixfmt, ui::Size(), mInputBufferSize) ||
+        mInputQueue->allocateBuffers(kNumInputBuffers, V4L2_MEMORY_MMAP) == 0 ||
+        !mInputQueue->streamon()) {
+        ALOGE("%s: can't set up the bitstream queue", __func__);
+        closeSession();
+        return false;
+    }
+    struct v4l2_event_subscription sub = {};
+    sub.type = V4L2_EVENT_EOS;
+    mDevice->ioctl(VIDIOC_SUBSCRIBE_EVENT, &sub);
+    if (!mDevice->startPolling(mTaskRunner,
+                               ::base::BindRepeating(&MfcDecoder::serviceDeviceTask, mWeakThis),
+                               ::base::BindRepeating(&MfcDecoder::onError, mWeakThis))) {
+        ALOGE("%s: can't poll the device", __func__);
+        closeSession();
+        return false;
+    }
+    mSessionFed = false;
+    ALOGV("%s: session open, %zu bitstream buffers of %zu bytes", __func__, kNumInputBuffers,
+          mInputBufferSize);
+    return true;
+}
+
+void MfcDecoder::closeSession() {
+    if (mDevice) mDevice->stopPolling();
+    // the queues' buffers are unmapped on deallocation: no reference may outlive it
+    while (!mDecodedFrames.empty()) mDecodedFrames.pop();
+    closeFimc();
+    if (mOutputQueue) {
+        mOutputQueue->streamoff();
+        mOutputQueue->deallocateBuffers();
+    }
+    if (mInputQueue) {
+        mInputQueue->streamoff();
+        mInputQueue->deallocateBuffers();
+    }
+    mOutputQueue = nullptr;
+    mInputQueue = nullptr;
+    mDevice = nullptr;
+    mVideoFramePool.reset();
+    mFetchingFrame = false;
+    mSessionFed = false;
+}
+
+// The frame side, once a header and a picture are queued. VIDIOC_G_FMT waits for the decoder to
+// parse the header; failing that, the stream can't be decoded.
+bool MfcDecoder::setupOutput() {
+    struct v4l2_format format = {};
+    format.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    if (mDevice->ioctl(VIDIOC_G_FMT, &format) != 0 || format.fmt.pix_mp.width == 0) {
+        ALOGE("%s: the decoder found no stream header", __func__);
+        return false;
+    }
+    const auto& pix = format.fmt.pix_mp;
+    if (pix.pixelformat != V4L2_PIX_FMT_NV12MT || pix.num_planes != 2) {
+        ALOGE("%s: unexpected frame format %s", __func__, fourccToString(pix.pixelformat).c_str());
+        return false;
+    }
+    mCodedSize = ui::Size(pix.width, pix.height);
+    // NV12MT: rows of 64x32 tiles in pairs (s5p-mfc leaves bytesperline at 0 and pads the plane
+    // sizes to 8 KiB)
+    mStride = (pix.width + 127) & ~127u;
+    mLumaLines = (pix.height + 31) & ~31u;
+    mChromaLines = (pix.height / 2 + 31) & ~31u;
+    if (mStride * mLumaLines > pix.plane_fmt[0].sizeimage ||
+        mStride * mChromaLines > pix.plane_fmt[1].sizeimage) {
+        ALOGE("%s: planes of %u and %u bytes for %ux%u", __func__, pix.plane_fmt[0].sizeimage,
+              pix.plane_fmt[1].sizeimage, pix.width, pix.height);
+        return false;
+    }
+
+    mVisibleRect = Rect(pix.width, pix.height);
+    struct v4l2_crop crop = {};
+    crop.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    if (mDevice->ioctl(VIDIOC_G_CROP, &crop) == 0 && crop.c.width && crop.c.height) {
+        mVisibleRect = Rect(crop.c.left, crop.c.top, crop.c.left + crop.c.width,
+                            crop.c.top + crop.c.height);
+    }
+
+    struct v4l2_control ctrl = {V4L2_CID_MIN_BUFFERS_FOR_CAPTURE, 0};
+    mDevice->ioctl(VIDIOC_G_CTRL, &ctrl);
+    // frames go straight back after the copy: the DPB and one more are enough
+    const size_t numBuffers = std::max<size_t>(ctrl.value, 1) + 2;
+    if (mOutputQueue->allocateBuffers(numBuffers, V4L2_MEMORY_MMAP) == 0) {
+        ALOGE("%s: can't allocate frame buffers", __func__);
+        return false;
+    }
+    if (!setupFimc()) closeFimc();
+    while (auto buffer = mOutputQueue->getFreeBuffer()) {
+        if (!std::move(*buffer).queueMMap()) return false;
+    }
+    if (!mOutputQueue->streamon()) return false;
+
+    // As large as the tiled frame, so that FIMC converts it 1:1 (minigbm's NV12 buffers: the
+    // stride is the width aligned to 64, the chroma plane follows the luma plane)
+    mVideoFramePool.reset();
+    mVideoFramePool = mGetPoolCb.Run(ui::Size(mStride, mLumaLines), HalPixelFormat::YCBCR_420_888,
+                                     std::max<size_t>(mMinNumOutputBuffers, 4));
+    if (!mVideoFramePool) {
+        ALOGE("%s: no frame pool", __func__);
+        return false;
+    }
+    ALOGI("%s: %ux%u (visible %dx%d), %zu frame buffers, detiling on the %s", __func__,
+          pix.width, pix.height, mVisibleRect.width(), mVisibleRect.height(), numBuffers,
+          mFimcFd >= 0 ? "FIMC" : "CPU");
+    return true;
+}
+
+bool MfcDecoder::setupFimc() {
+    // fimc.1 first: the rear camera captures through fimc.0
+    for (const std::string want : {"fimc.1.m2m", "fimc.0.m2m"}) {
+        for (int i = 0; i < 32; i++) {
+            std::ifstream file(::base::StringPrintf("/sys/class/video4linux/video%d/name", i));
+            std::string name;
+            if (!std::getline(file, name) || name != want) continue;
+            if (openFimc(::base::StringPrintf("/dev/video%d", i))) return true;
+            ALOGW("%s: %s is not available", __func__, want.c_str());
+            closeFimc();
+            break;
+        }
+    }
+    return false;
+}
+
+bool MfcDecoder::openFimc(const std::string& path) {
+    mFimcFd = open(path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (mFimcFd < 0) return false;
+
+    // in: the decoder's NV12MT frame (two planes), out: NV12 of the same size in one buffer
+    struct v4l2_format in = {};
+    in.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    in.fmt.pix_mp.pixelformat = V4L2_PIX_FMT_NV12MT;
+    in.fmt.pix_mp.width = mStride;
+    in.fmt.pix_mp.height = mLumaLines;
+    in.fmt.pix_mp.num_planes = 2;
+    in.fmt.pix_mp.plane_fmt[0].bytesperline = mStride;
+    in.fmt.pix_mp.plane_fmt[0].sizeimage = mStride * mLumaLines;
+    in.fmt.pix_mp.plane_fmt[1].bytesperline = mStride;
+    in.fmt.pix_mp.plane_fmt[1].sizeimage = mStride * mChromaLines;
+    struct v4l2_format out = {};
+    out.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    out.fmt.pix_mp.pixelformat = V4L2_PIX_FMT_NV12;
+    out.fmt.pix_mp.width = mStride;
+    out.fmt.pix_mp.height = mLumaLines;
+    out.fmt.pix_mp.num_planes = 1;
+    out.fmt.pix_mp.plane_fmt[0].bytesperline = mStride;
+    if (xioctl(mFimcFd, VIDIOC_S_FMT, &in) != 0 || xioctl(mFimcFd, VIDIOC_S_FMT, &out) != 0 ||
+        in.fmt.pix_mp.width != mStride || in.fmt.pix_mp.height != mLumaLines ||
+        out.fmt.pix_mp.width != mStride || out.fmt.pix_mp.height != mLumaLines ||
+        out.fmt.pix_mp.plane_fmt[0].bytesperline != mStride) {
+        ALOGW("%s: %s can't convert %zux%zu", __func__, path.c_str(), mStride, mLumaLines);
+        return false;
+    }
+
+    const size_t numFrames = mOutputQueue->allocatedBuffersCount();
+    struct v4l2_requestbuffers reqIn = {};
+    reqIn.count = numFrames;
+    reqIn.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    reqIn.memory = V4L2_MEMORY_DMABUF;
+    struct v4l2_requestbuffers reqOut = {};
+    reqOut.count = kFimcFrameSlots;
+    reqOut.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    reqOut.memory = V4L2_MEMORY_DMABUF;
+    if (xioctl(mFimcFd, VIDIOC_REQBUFS, &reqIn) != 0 || reqIn.count < numFrames ||
+        xioctl(mFimcFd, VIDIOC_REQBUFS, &reqOut) != 0 || reqOut.count < kFimcFrameSlots) {
+        ALOGW("%s: %s: no DMABUF buffers", __func__, path.c_str());
+        return false;
+    }
+
+    for (size_t i = 0; i < numFrames; i++) {
+        std::array<int, 2> fds = {-1, -1};
+        for (size_t plane = 0; plane < 2; plane++) {
+            struct v4l2_exportbuffer exp = {};
+            exp.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+            exp.index = i;
+            exp.plane = plane;
+            exp.flags = O_RDONLY | O_CLOEXEC;
+            if (mDevice->ioctl(VIDIOC_EXPBUF, &exp) == 0) fds[plane] = exp.fd;
+        }
+        mFrameDmabufs.push_back(fds);
+        if (fds[0] < 0 || fds[1] < 0) {
+            ALOGW("%s: can't export the decoder's frame buffers", __func__);
+            return false;
+        }
+    }
+
+    for (int type : {V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE}) {
+        if (xioctl(mFimcFd, VIDIOC_STREAMON, &type) != 0) return false;
+    }
+    ALOGV("%s: %s", __func__, path.c_str());
+    return true;
+}
+
+void MfcDecoder::closeFimc() {
+    if (mFimcFd >= 0) {
+        for (int type : {V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE}) {
+            xioctl(mFimcFd, VIDIOC_STREAMOFF, &type);
+            struct v4l2_requestbuffers req = {};
+            req.type = type;
+            req.memory = V4L2_MEMORY_DMABUF;
+            xioctl(mFimcFd, VIDIOC_REQBUFS, &req);
+        }
+        close(mFimcFd);
+        mFimcFd = -1;
+    }
+    for (const auto& fds : mFrameDmabufs) {
+        for (int fd : fds) {
+            if (fd >= 0) close(fd);
+        }
+    }
+    mFrameDmabufs.clear();
+}
+
+bool MfcDecoder::detileOnFimc(const DecodedFrame& decoded, VideoFrame* frame, uint32_t blockId) {
+    const size_t id = decoded.buffer->bufferId();
+    struct v4l2_plane inPlanes[2] = {};
+    struct v4l2_buffer in = {};
+    in.type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
+    in.memory = V4L2_MEMORY_DMABUF;
+    in.index = id;
+    in.m.planes = inPlanes;
+    in.length = 2;
+    for (size_t plane = 0; plane < 2; plane++) {
+        inPlanes[plane].m.fd = mFrameDmabufs[id][plane];
+        // vb2 wants the length of an imported output plane (the capture side takes the DMABUF's)
+        inPlanes[plane].length = mStride * (plane == 0 ? mLumaLines : mChromaLines);
+        inPlanes[plane].bytesused = inPlanes[plane].length;
+    }
+    struct v4l2_plane outPlane = {};
+    struct v4l2_buffer out = {};
+    out.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    out.memory = V4L2_MEMORY_DMABUF;
+    out.index = blockId % kFimcFrameSlots;
+    out.m.planes = &outPlane;
+    out.length = 1;
+    outPlane.m.fd = frame->getFDs()[0];
+    if (xioctl(mFimcFd, VIDIOC_QBUF, &in) != 0 || xioctl(mFimcFd, VIDIOC_QBUF, &out) != 0) {
+        ALOGE("%s: VIDIOC_QBUF failed: %s", __func__, strerror(errno));
+        return false;
+    }
+    struct pollfd pfd = {mFimcFd, POLLIN, 0};
+    if (poll(&pfd, 1, kFimcTimeoutMs) <= 0) {
+        ALOGE("%s: no frame from FIMC", __func__);
+        return false;
+    }
+    if (xioctl(mFimcFd, VIDIOC_DQBUF, &out) != 0 || xioctl(mFimcFd, VIDIOC_DQBUF, &in) != 0 ||
+        (out.flags & V4L2_BUF_FLAG_ERROR)) {
+        ALOGE("%s: FIMC failed", __func__);
+        return false;
+    }
+    return true;
+}
+
+void MfcDecoder::decode(std::unique_ptr<ConstBitstreamBuffer> buffer, DecodeCB decodeCb) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+    if (mError) {
+        std::move(decodeCb).Run(DecodeStatus::kError);
+        return;
+    }
+    mDecodeRequests.push({std::move(buffer), std::move(decodeCb)});
+    pumpDecodeRequests();
+}
+
+void MfcDecoder::drain(DecodeCB drainCb) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+    if (mError) {
+        std::move(drainCb).Run(DecodeStatus::kError);
+        return;
+    }
+    mDecodeRequests.push({nullptr, std::move(drainCb)});
+    pumpDecodeRequests();
+}
+
+void MfcDecoder::flush() {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+    ALOGV("%s()", __func__);
+    // The MFC v5 can't seek within a session: start a new one with the next buffer
+    closeSession();
+    for (auto& [id, cb] : mPendingDecodeCbs) std::move(cb).Run(DecodeStatus::kAborted);
+    mPendingDecodeCbs.clear();
+    while (!mDecodeRequests.empty()) {
+        std::move(mDecodeRequests.front().decodeCb).Run(DecodeStatus::kAborted);
+        mDecodeRequests.pop();
+    }
+    mDrainPending = false;
+    if (mDrainCb) std::move(mDrainCb).Run(DecodeStatus::kAborted);
+}
+
+bool MfcDecoder::queueBitstream(const uint8_t* data, size_t size, int32_t bitstreamId) {
+    auto buffer = mInputQueue->getFreeBuffer();
+    if (!buffer) return false;
+    if (size > buffer->getPlaneSize(0)) {
+        ALOGE("%s: %zu bytes don't fit into %zu", __func__, size, buffer->getPlaneSize(0));
+        onError();
+        return false;
+    }
+    memcpy(buffer->getPlaneMapping(0), data, size);
+    buffer->setPlaneBytesUsed(0, size);
+    buffer->setTimeStamp({.tv_sec = bitstreamId, .tv_usec = 0});
+    if (!std::move(*buffer).queueMMap()) {
+        onError();
+        return false;
+    }
+    mSessionFed = true;
+    return true;
+}
+
+void MfcDecoder::pumpDecodeRequests() {
+    while (!mDecodeRequests.empty() && !mError && !mDrainCb) {
+        DecodeRequest& request = mDecodeRequests.front();
+
+        if (!request.buffer) {  // drain
+            if (!mDevice || !mSessionFed || !mOutputQueue->isStreaming()) {
+                // nothing to drain (no frame can come out of this session)
+                DecodeCB cb = std::move(request.decodeCb);
+                mDecodeRequests.pop();
+                std::move(cb).Run(DecodeStatus::kOk);
+                continue;
+            }
+            if (mInputQueue->queuedBuffersCount() > 0) return;  // after the last bitstream
+            struct v4l2_decoder_cmd cmd = {};
+            cmd.cmd = V4L2_DEC_CMD_STOP;
+            if (mDevice->ioctl(VIDIOC_DECODER_CMD, &cmd) != 0) {
+                ALOGE("%s: V4L2_DEC_CMD_STOP failed", __func__);
+                onError();
+                return;
+            }
+            mDrainCb = std::move(request.decodeCb);
+            mDecodeRequests.pop();
+            return;  // the rest waits for the last frame
+        }
+
+        C2ReadView view = request.buffer->dmabuf.map().get();
+        if (view.error() != C2_OK) {
+            ALOGE("%s: can't map the bitstream: %d", __func__, view.error());
+            onError();
+            return;
+        }
+        const uint8_t* data = view.data() + request.buffer->offset;
+        const size_t size = request.buffer->size;
+        NalScan scan = scanH264(data, size);
+        if (!scan.sps.empty() || !scan.pps.empty()) {
+            // keep the stream's parameter sets for the next session
+            std::vector<uint8_t> sps, pps;
+            NalScan old = scanH264(mCodecConfig.data(), mCodecConfig.size());
+            sps = scan.sps.empty() ? old.sps : scan.sps;
+            pps = scan.pps.empty() ? old.pps : scan.pps;
+            mCodecConfig = sps;
+            mCodecConfig.insert(mCodecConfig.end(), pps.begin(), pps.end());
+        }
+        if (!scan.slices) {
+            // codec config only: it goes to the decoder ahead of the first picture
+            DecodeCB cb = std::move(request.decodeCb);
+            mDecodeRequests.pop();
+            std::move(cb).Run(DecodeStatus::kOk);
+            continue;
+        }
+
+        if (!mDevice && !openSession()) {
+            onError();
+            return;
+        }
+        if (!mSessionFed) {
+            // a new session: the header goes in a buffer of its own
+            if (mInputQueue->freeBuffersCount() < 2) return;
+            if (!mCodecConfig.empty() &&
+                !queueBitstream(mCodecConfig.data(), mCodecConfig.size(), kConfigBitstreamId)) {
+                return;
+            }
+        }
+        if (mInputQueue->freeBuffersCount() == 0) return;
+        const int32_t id = request.buffer->id;
+        if (!queueBitstream(data, size, id)) return;
+        mPendingDecodeCbs.emplace(id, std::move(request.decodeCb));
+        mDecodeRequests.pop();
+
+        if (!mOutputQueue->isStreaming() && !setupOutput()) {
+            onError();
+            return;
+        }
+    }
+}
+
+void MfcDecoder::serviceDeviceTask(bool event) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+    if (mError || !mDevice) return;
+
+    while (mInputQueue->queuedBuffersCount() > 0) {
+        auto [ok, buffer] = mInputQueue->dequeueBuffer();
+        if (!ok) {
+            onError();
+            return;
+        }
+        if (!buffer) break;
+        const int32_t id = static_cast<int32_t>(buffer->getTimeStamp().tv_sec);
+        auto it = mPendingDecodeCbs.find(id);
+        if (it != mPendingDecodeCbs.end()) {
+            std::move(it->second).Run(DecodeStatus::kOk);
+            mPendingDecodeCbs.erase(it);
+        }
+    }
+
+    bool last = false;
+    while (mOutputQueue->isStreaming() && mOutputQueue->queuedBuffersCount() > 0) {
+        auto [ok, buffer] = mOutputQueue->dequeueBuffer();
+        if (!ok) {
+            onError();
+            return;
+        }
+        if (!buffer) break;
+        last |= buffer->isLast();
+        if (buffer->getPlaneBytesUsed(0) > 0) {
+            mDecodedFrames.push({buffer, static_cast<int32_t>(buffer->getTimeStamp().tv_sec)});
+        } else if (!buffer->isLast() && !requeueOutput(std::move(buffer))) {
+            return;
+        }
+    }
+    if (event) {
+        struct v4l2_event ev = {};
+        while (mDevice->ioctl(VIDIOC_DQEVENT, &ev) == 0) {
+            if (ev.type == V4L2_EVENT_EOS) last = true;
+        }
+    }
+    if (last && mDrainCb) mDrainPending = true;
+
+    fetchFrame();
+    finishDrain();
+    pumpDecodeRequests();
+}
+
+bool MfcDecoder::requeueOutput(V4L2ReadableBufferRef buffer) {
+    const size_t id = buffer->bufferId();
+    buffer.reset();
+    auto free = mOutputQueue->getFreeBuffer(id);
+    if (!free || !std::move(*free).queueMMap()) {
+        ALOGE("%s: can't requeue frame buffer %zu", __func__, id);
+        onError();
+        return false;
+    }
+    return true;
+}
+
+void MfcDecoder::fetchFrame() {
+    if (mFetchingFrame || mDecodedFrames.empty() || !mVideoFramePool) return;
+    mFetchingFrame = true;
+    if (!mVideoFramePool->getVideoFrame(::base::BindOnce(&MfcDecoder::onFrameReady, mWeakThis))) {
+        mFetchingFrame = false;
+    }
+}
+
+void MfcDecoder::onFrameReady(std::optional<VideoFramePool::FrameWithBlockId> frameWithBlockId) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+    mFetchingFrame = false;
+    if (mError || mDecodedFrames.empty()) return;  // flushed meanwhile
+    if (!frameWithBlockId) {
+        ALOGE("%s: no frame from the pool", __func__);
+        onError();
+        return;
+    }
+    std::unique_ptr<VideoFrame> frame = std::move(frameWithBlockId->first);
+    DecodedFrame decoded = std::move(mDecodedFrames.front());
+    mDecodedFrames.pop();
+
+    if (mFimcFd < 0 || !detileOnFimc(decoded, frame.get(), frameWithBlockId->second)) {
+        if (mFimcFd >= 0) {
+            ALOGW("%s: detiling on the CPU from now on", __func__);
+            closeFimc();
+        }
+        if (!detileOnCpu(decoded, frame.get())) {
+            onError();
+            return;
+        }
+    }
+
+    if (!requeueOutput(std::move(decoded.buffer))) return;
+    frame->setBitstreamId(decoded.bitstreamId);
+    frame->setVisibleRect(mVisibleRect);
+    mOutputCb.Run(std::move(frame));
+
+    fetchFrame();
+    finishDrain();
+}
+
+bool MfcDecoder::detileOnCpu(const DecodedFrame& decoded, VideoFrame* frame) {
+    {
+        C2GraphicView view = frame->map().get();
+        if (view.error() != C2_OK) {
+            ALOGE("%s: can't map the frame: %d", __func__, view.error());
+            return false;
+        }
+        const C2PlanarLayout& layout = view.layout();
+        uint8_t* const* planes = view.data();
+        const auto* srcY = static_cast<const uint8_t*>(decoded.buffer->getPlaneMapping(0));
+        const auto* srcUV = static_cast<const uint8_t*>(decoded.buffer->getPlaneMapping(1));
+        const unsigned width = mVisibleRect.right, height = mVisibleRect.bottom;
+        const C2PlaneInfo& y = layout.planes[C2PlanarLayout::PLANE_Y];
+        const C2PlaneInfo& u = layout.planes[C2PlanarLayout::PLANE_U];
+        nv12mt_detile_plane(srcY, mStride, mLumaLines, width, height,
+                            planes[C2PlanarLayout::PLANE_Y], y.rowInc);
+        if (u.colInc == 2 && planes[C2PlanarLayout::PLANE_V] == planes[C2PlanarLayout::PLANE_U] + 1) {
+            // NV12
+            nv12mt_detile_plane(srcUV, mStride, mChromaLines, width, height / 2,
+                                planes[C2PlanarLayout::PLANE_U], u.rowInc);
+        } else {
+            // anything else (NV21, planar): through an interleaved copy
+            const C2PlaneInfo& v = layout.planes[C2PlanarLayout::PLANE_V];
+            std::vector<uint8_t> uv(width * (height / 2));
+            nv12mt_detile_plane(srcUV, mStride, mChromaLines, width, height / 2, uv.data(),
+                                width);
+            for (unsigned r = 0; r < height / 2; r++) {
+                for (unsigned c = 0; c < width / 2; c++) {
+                    planes[C2PlanarLayout::PLANE_U][r * u.rowInc + c * u.colInc] =
+                            uv[r * width + 2 * c];
+                    planes[C2PlanarLayout::PLANE_V][r * v.rowInc + c * v.colInc] =
+                            uv[r * width + 2 * c + 1];
+                }
+            }
+        }
+    }
+    return true;
+}
+
+// A drain is done once the last frame is out; the MFC v5 can't continue after it
+void MfcDecoder::finishDrain() {
+    if (!mDrainPending || !mDecodedFrames.empty() || mFetchingFrame) return;
+    mDrainPending = false;
+    DecodeCB cb = std::move(mDrainCb);
+    closeSession();
+    std::move(cb).Run(DecodeStatus::kOk);
+    pumpDecodeRequests();
+}
+
+void MfcDecoder::onError() {
+    ALOGE("%s()", __func__);
+    mError = true;
+    mErrorCb.Run();
+}
+
+}  // namespace android
